import { ActionEditorPopover } from "action_editor.slint";

component DarkField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;

    height: 54px;
    background: transparent;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: root.label;
            color: #a1a1aa;
            font-size: 11px;
            font-weight: 500;
        }

        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: rgba(18, 18, 18, 0.95);
            border-width: 1px;
            border-color: input.has-focus ? rgba(255, 255, 255, 0.45) : rgba(255, 255, 255, 0.12);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: stretch;

                input := TextInput {
                    text <=> root.value;
                    color: #f5f5f7;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                }
            }

            if root.value == "" && !input.has-focus: Text {
                x: 10px;
                text: root.placeholder;
                color: rgba(255, 255, 255, 0.28);
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

component DarkButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: root.primary
        ? (touch.has-hover ? #3b82f6 : #2563eb)
        : (root.danger
            ? (touch.has-hover ? rgba(220, 38, 38, 0.35) : rgba(220, 38, 38, 0.2))
            : (touch.has-hover ? rgba(255, 255, 255, 0.14) : rgba(255, 255, 255, 0.08)));
    border-width: 1px;
    border-color: root.primary
        ? rgba(147, 197, 253, 0.4)
        : (root.danger ? rgba(248, 113, 113, 0.35) : rgba(255, 255, 255, 0.12));

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;

        Text {
            text: root.text;
            color: #f5f5f7;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ActionRow inherits Rectangle {
    in property <string> control-label;
    in property <string> action-summary;
    callback edit-clicked();

    height: 40px;
    border-radius: 7px;
    background: rgba(18, 18, 20, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        alignment: stretch;

        Text {
            width: 155px;
            text: root.control-label;
            color: #d4d4d8;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.action-summary;
            color: #f5f5f7;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        DarkButton {
            width: 68px;
            height: 26px;
            text: "Editar";
            clicked => { root.edit-clicked(); }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "KnobContext Settings";
    width: 820px;
    height: 620px;
    background: rgba(20, 20, 20, 0.92);

    in property <[string]> profile-names: ["global"];
    in property <[string]> preset-labels: [];
    in property <bool> preset-picker-open: false;
    in property <int> selected-index: 0;
    in-out property <string> field-name;
    in-out property <string> field-window-class;
    in-out property <string> field-window-title;
    in-out property <string> field-inherits;
    in property <int> field-priority: 0;
    in property <bool> field-fullscreen-only: false;
    in property <string> captured-window-hint: "";
    in property <string> summary-rotate-cw: "Nenhuma";
    in property <string> summary-rotate-ccw: "Nenhuma";
    in property <string> summary-key1: "Nenhuma";
    in property <string> summary-key2: "Nenhuma";
    in property <string> summary-key3: "Nenhuma";
    in property <bool> has-unsaved-changes: false;
    in-out property <string> error-message;

    // Estado do Popover de edição de ação
    in property <bool> editor-open: false;
    in property <string> editor-control-title;
    in property <[string]> editor-type-titles;
    in property <int> editor-type-index: 0;
    in-out property <string> editor-shortcut-text;
    in property <bool> editor-capturing-shortcut: false;
    in property <int> editor-media-index: 0;
    in-out property <string> editor-app-search;
    in property <[string]> editor-filtered-apps;
    in property <int> editor-selected-app-index: -1;
    in-out property <string> editor-url-text;
    in-out property <string> editor-file-text;
    in-out property <string> editor-exec-text;
    in property <int> editor-scroll-direction: 0;
    in property <int> editor-scroll-amount: 1;
    in property <[string]> editor-macro-steps;
    in-out property <string> editor-macro-key-text;
    in-out property <string> editor-macro-wait-text: "100";
    in property <bool> editor-capturing-macro: false;
    in property <string> editor-error-message;

    callback select-profile(int);
    callback add-profile();
    callback toggle-preset-picker();
    callback add-preset(int);
    callback remove-profile();
    callback capture-active-window();
    callback change-priority(int);
    callback toggle-fullscreen-only();
    callback open-action-editor(int);
    callback save-requested();
    callback cancel-requested();

    // Callbacks do Popover
    callback editor-select-type(int);
    callback editor-toggle-shortcut-capture();
    callback editor-shortcut-key-captured(string, bool, bool, bool, bool);
    callback editor-select-media(int);
    callback editor-app-search-changed(string);
    callback editor-select-app(int);
    callback editor-pick-file();
    callback editor-select-scroll-direction(int);
    callback editor-change-scroll-amount(int);
    callback editor-toggle-macro-capture();
    callback editor-macro-key-captured(string, bool, bool, bool, bool);
    callback editor-add-macro-key();
    callback editor-add-macro-wait();
    callback editor-remove-macro-step(int);
    callback editor-save();
    callback editor-cancel();

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        // Coluna esquerda: lista de perfis
        Rectangle {
            width: 200px;
            border-radius: 10px;
            background: rgba(30, 30, 30, 0.9);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.1);

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Perfis";
                    color: #f5f5f7;
                    font-size: 15px;
                    font-weight: 700;
                }

                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    for name[idx] in root.profile-names: Rectangle {
                        height: 34px;
                        border-radius: 7px;
                        background: idx == root.selected-index
                            ? rgba(255, 255, 255, 0.18)
                            : (item-touch.has-hover ? rgba(255, 255, 255, 0.08) : rgba(255, 255, 255, 0.03));
                        border-width: 1px;
                        border-color: idx == root.selected-index
                            ? rgba(255, 255, 255, 0.35)
                            : rgba(255, 255, 255, 0.06);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;

                            Text {
                                text: name;
                                color: idx == root.selected-index ? #ffffff : #d4d4d8;
                                font-size: 13px;
                                font-weight: idx == root.selected-index ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }

                        item-touch := TouchArea {
                            clicked => { root.select-profile(idx); }
                        }
                    }
                }

                DarkButton {
                    text: "+ Adicionar perfil";
                    clicked => { root.add-profile(); }
                }

                DarkButton {
                    text: root.preset-picker-open ? "Fechar presets" : "+ Preset contextual";
                    clicked => { root.toggle-preset-picker(); }
                }

                DarkButton {
                    text: "Remover perfil";
                    danger: true;
                    clicked => { root.remove-profile(); }
                }
            }
        }

        // Coluna direita: editor do perfil selecionado
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 10px;
            background: rgba(30, 30, 30, 0.9);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.1);

            VerticalLayout {
                padding: 14px;
                spacing: 7px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Configuração do Perfil";
                        color: #f5f5f7;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    if root.has-unsaved-changes: Text {
                        text: "• alterações não salvas";
                        color: #fbbf24;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    DarkField {
                        horizontal-stretch: 1;
                        label: "Nome do perfil";
                        placeholder: "ex: video_web";
                        value <=> root.field-name;
                    }

                    DarkField {
                        horizontal-stretch: 2;
                        label: "Janela (WINDOWCLASS, use | para várias)";
                        placeholder: "ex: firefox|zen|chromium";
                        value <=> root.field-window-class;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Detectar";
                            color: #a1a1aa;
                            font-size: 11px;
                            font-weight: 500;
                        }
                        DarkButton {
                            width: 108px;
                            text: "Capturar";
                            clicked => { root.capture-active-window(); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    DarkField {
                        horizontal-stretch: 2;
                        label: "Título contém (opcional, use |)";
                        placeholder: "ex: YouTube|Twitch|Netflix";
                        value <=> root.field-window-title;
                    }

                    DarkField {
                        horizontal-stretch: 1;
                        label: "Herdar de (opcional)";
                        placeholder: "ex: global";
                        value <=> root.field-inherits;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Prioridade:";
                            color: #a1a1aa;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        DarkButton {
                            width: 28px;
                            height: 26px;
                            text: "-";
                            clicked => { root.change-priority(-5); }
                        }
                        Text {
                            width: 30px;
                            text: root.field-priority;
                            color: #f5f5f7;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        DarkButton {
                            width: 28px;
                            height: 26px;
                            text: "+";
                            clicked => { root.change-priority(5); }
                        }
                    }

                    DarkButton {
                        height: 26px;
                        primary: root.field-fullscreen-only;
                        text: root.field-fullscreen-only ? "Tela cheia: SIM" : "Tela cheia: Qualquer";
                        clicked => { root.toggle-fullscreen-only(); }
                    }

                    if root.captured-window-hint != "": Text {
                        horizontal-stretch: 1;
                        text: root.captured-window-hint;
                        color: #93c5fd;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                ActionRow {
                    control-label: "RotateCw (Horário)";
                    action-summary: root.summary-rotate-cw;
                    edit-clicked => { root.open-action-editor(0); }
                }

                ActionRow {
                    control-label: "RotateCcw (Anti-horário)";
                    action-summary: root.summary-rotate-ccw;
                    edit-clicked => { root.open-action-editor(1); }
                }

                ActionRow {
                    control-label: "Key1 (Esquerda)";
                    action-summary: root.summary-key1;
                    edit-clicked => { root.open-action-editor(2); }
                }

                ActionRow {
                    control-label: "Key2 (Meio)";
                    action-summary: root.summary-key2;
                    edit-clicked => { root.open-action-editor(3); }
                }

                ActionRow {
                    control-label: "Key3 (Direita)";
                    action-summary: root.summary-key3;
                    edit-clicked => { root.open-action-editor(4); }
                }

                Text {
                    text: "Nota: o clique no knob (KnobPress) é reservado para abrir/fechar o overlay de perfis.";
                    color: rgba(255, 255, 255, 0.48);
                    font-size: 11px;
                }

                if root.error-message != "": Rectangle {
                    border-radius: 6px;
                    background: rgba(220, 38, 38, 0.22);
                    border-width: 1px;
                    border-color: rgba(248, 113, 113, 0.45);

                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: root.error-message;
                            color: #fca5a5;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    DarkButton {
                        text: "Cancelar";
                        clicked => { root.cancel-requested(); }
                    }

                    DarkButton {
                        text: "Salvar";
                        primary: true;
                        clicked => { root.save-requested(); }
                    }
                }
            }
        }
    }

    if root.preset-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.62);

        TouchArea {
            clicked => { root.toggle-preset-picker(); }
        }

        Rectangle {
            width: 420px;
            height: 360px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: rgba(24, 24, 27, 0.98);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.16);

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: "Adicionar Preset Contextual";
                    color: #f5f5f7;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: "Escolha um comportamento pronto para adicionar aos seus perfis:";
                    color: #a1a1aa;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    for label[idx] in root.preset-labels: DarkButton {
                        height: 34px;
                        text: label;
                        clicked => { root.add-preset(idx); }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    DarkButton {
                        text: "Fechar";
                        clicked => { root.toggle-preset-picker(); }
                    }
                }
            }
        }
    }

    if root.editor-open: ActionEditorPopover {
        width: 100%;
        height: 100%;
        control-title: root.editor-control-title;
        type-titles: root.editor-type-titles;
        selected-type-index: root.editor-type-index;
        shortcut-text <=> root.editor-shortcut-text;
        capturing-shortcut: root.editor-capturing-shortcut;
        selected-media-index: root.editor-media-index;
        app-search <=> root.editor-app-search;
        filtered-app-names: root.editor-filtered-apps;
        selected-app-index: root.editor-selected-app-index;
        url-text <=> root.editor-url-text;
        file-text <=> root.editor-file-text;
        exec-text <=> root.editor-exec-text;
        scroll-direction-index: root.editor-scroll-direction;
        scroll-amount: root.editor-scroll-amount;
        macro-step-labels: root.editor-macro-steps;
        macro-key-text <=> root.editor-macro-key-text;
        macro-wait-text <=> root.editor-macro-wait-text;
        capturing-macro-key: root.editor-capturing-macro;
        error-message: root.editor-error-message;

        select-type(i) => { root.editor-select-type(i); }
        toggle-shortcut-capture => { root.editor-toggle-shortcut-capture(); }
        shortcut-key-captured(t, c, a, s, m) => { root.editor-shortcut-key-captured(t, c, a, s, m); }
        select-media(i) => { root.editor-select-media(i); }
        app-search-changed(q) => { root.editor-app-search-changed(q); }
        select-app(i) => { root.editor-select-app(i); }
        pick-file => { root.editor-pick-file(); }
        select-scroll-direction(i) => { root.editor-select-scroll-direction(i); }
        change-scroll-amount(d) => { root.editor-change-scroll-amount(d); }
        toggle-macro-capture => { root.editor-toggle-macro-capture(); }
        macro-key-captured(t, c, a, s, m) => { root.editor-macro-key-captured(t, c, a, s, m); }
        add-macro-key => { root.editor-add-macro-key(); }
        add-macro-wait => { root.editor-add-macro-wait(); }
        remove-macro-step(i) => { root.editor-remove-macro-step(i); }
        save-action => { root.editor-save(); }
        cancel-action => { root.editor-cancel(); }
    }
}
