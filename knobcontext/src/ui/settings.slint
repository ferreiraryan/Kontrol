import {
    Theme,
    AppButton,
    AppField,
    ToggleSwitch,
    SegmentedTwo,
    SegmentedThree,
    StepperControl,
    ActionCategoryBadge,
    ProfileListItem,
    ControlSlotView,
    AppListItem,
    MacroStepItem,
    PresetListItem,
    ProviderOptionItem,
    ProviderCommandItem,
} from "theme.slint";
import { ActionEditorPopover } from "action_editor.slint";

component RotaryControlCard inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <ControlSlotView> slot;
    callback edit-clicked();
    callback learn-clicked();
    callback clear-clicked();

    height: 92px;
    border-radius: 10px;
    background: card-touch.has-hover ? Theme.bg-elevated : Theme.bg-card;
    border-width: 1px;
    border-color: card-touch.has-hover ? Theme.border-hover : Theme.border-subtle;

    animate background { duration: 110ms; easing: ease-out; }
    animate border-color { duration: 110ms; easing: ease-out; }

    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit-clicked(); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 7px;

        HorizontalLayout {
            spacing: 6px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.glyph;
                    color: Theme.accent-text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.title;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            ActionCategoryBadge {
                category: root.slot.category;
                inherited: root.slot.is-inherited;
            }
        }

        Text {
            text: root.slot.is-inherited
                ? ("Herdado de " + root.slot.inherited-from + ": " + root.slot.summary)
                : root.slot.summary;
            color: root.slot.is-inherited
                ? Theme.text-muted
                : (root.slot.category == 8 ? Theme.text-dim : Theme.text-primary);
            font-size: 13px;
            font-weight: root.slot.is-inherited ? 400 : 600;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            AppButton {
                height: 24px;
                font-size: 11px;
                text: "⌨ Aprender";
                clicked => { root.learn-clicked(); }
            }

            AppButton {
                height: 24px;
                font-size: 11px;
                text: "Editar";
                clicked => { root.edit-clicked(); }
            }

            if root.slot.can-clear: AppButton {
                width: 26px;
                height: 24px;
                font-size: 12px;
                ghost: true;
                text: "×";
                clicked => { root.clear-clicked(); }
            }
        }
    }
}

component PhysicalKeyRow inherits Rectangle {
    in property <string> key-code;
    in property <string> key-label;
    in property <ControlSlotView> slot;
    callback edit-clicked();
    callback learn-clicked();
    callback clear-clicked();

    height: 44px;
    border-radius: 9px;
    background: row-touch.has-hover ? Theme.bg-elevated : Theme.bg-card;
    border-width: 1px;
    border-color: row-touch.has-hover ? Theme.border-hover : Theme.border-subtle;

    animate background { duration: 110ms; easing: ease-out; }
    animate border-color { duration: 110ms; easing: ease-out; }

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit-clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        alignment: stretch;

        // Keycap física (K1 / K2 / K3)
        Rectangle {
            width: 30px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-default;

            Text {
                text: root.key-code;
                color: Theme.text-primary;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            width: 68px;
            text: root.key-label;
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        ActionCategoryBadge {
            y: (parent.height - self.height) / 2;
            category: root.slot.category;
            inherited: root.slot.is-inherited;
        }

        Text {
            horizontal-stretch: 1;
            text: root.slot.is-inherited
                ? (root.slot.summary + " (" + root.slot.inherited-from + ")")
                : root.slot.summary;
            color: root.slot.is-inherited
                ? Theme.text-muted
                : (root.slot.category == 8 ? Theme.text-dim : Theme.text-primary);
            font-size: 12px;
            font-weight: root.slot.is-inherited ? 400 : 500;
            vertical-alignment: center;
            overflow: elide;
        }

        AppButton {
            y: (parent.height - self.height) / 2;
            height: 26px;
            font-size: 11px;
            text: "⌨ Aprender";
            clicked => { root.learn-clicked(); }
        }

        AppButton {
            y: (parent.height - self.height) / 2;
            height: 26px;
            font-size: 11px;
            text: "Editar";
            clicked => { root.edit-clicked(); }
        }

        if root.slot.can-clear: AppButton {
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            font-size: 13px;
            ghost: true;
            text: "×";
            clicked => { root.clear-clicked(); }
        }
    }
}

component SimpleActionRow inherits Rectangle {
    in property <string> control-label;
    in property <string> action-summary;
    callback edit-clicked();

    height: 40px;
    border-radius: 8px;
    background: r-touch.has-hover ? Theme.bg-elevated : Theme.bg-card;
    border-width: 1px;
    border-color: r-touch.has-hover ? Theme.border-hover : Theme.border-subtle;

    r-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit-clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            width: 140px;
            text: root.control-label;
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.action-summary;
            color: Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        AppButton {
            y: (parent.height - self.height) / 2;
            height: 26px;
            font-size: 11px;
            text: "Editar";
            clicked => { root.edit-clicked(); }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "KnobContext Settings";
    width: 920px;
    height: 680px;
    background: Theme.bg-window;

    // Aba principal: 0 = Perfis & Contexto, 1 = Overlay / Hub
    in property <int> active-tab: 0;
    // Sub-aba dentro de Overlay / Hub: 0 = Itens Padrão do Hub, 1 = Aparência e Comportamento
    in property <int> hub-subtab: 0;

    // --- Aba 0: Perfis & Contexto ---
    in property <[ProfileListItem]> profile-items: [];
    in property <[string]> preset-labels: [];
    in property <bool> preset-picker-open: false;
    in property <int> selected-index: 0;
    in property <bool> selected-is-global: true;
    in property <bool> context-rules-expanded: true;
    in property <string> context-rules-summary: "";
    in-out property <string> field-name;
    in-out property <string> field-window-class;
    in-out property <string> field-window-title;
    in property <string> field-inherits-label: "Nenhum";
    in property <[string]> inherits-options: ["Nenhum"];
    in property <bool> inherits-picker-open: false;
    in property <[string]> inherits-chain: [];
    in property <int> field-priority: 0;
    in property <bool> field-fullscreen-only: false;
    in property <string> captured-window-hint: "";

    in property <ControlSlotView> slot-rotate-cw;
    in property <ControlSlotView> slot-rotate-ccw;
    in property <ControlSlotView> slot-key1;
    in property <ControlSlotView> slot-key2;
    in property <ControlSlotView> slot-key3;

    // Sub-aba dentro de Perfis & Contexto: 0 = Ações do Knob, 1 = Módulos do Hub
    in property <int> profile-subtab: 0;
    in property <string> profile-hub-subtab-label: "Módulos do Hub";
    in property <bool> profile-hub-is-inherited: true;
    in property <string> profile-hub-status-text: "Herdado de global";
    in property <[string]> profile-hub-module-labels: [];
    in property <int> profile-hub-selected-index: 0;
    in-out property <string> profile-hub-selected-title: "";
    in property <bool> profile-hub-picker-open: false;
    in property <[string]> profile-hub-template-labels: [];

    // --- Aba 1: Overlay / Hub ---
    in property <[string]> hub-item-labels: [];
    in property <[bool]> hub-item-enabled-flags: [];
    in property <int> hub-selected-index: 0;
    in-out property <string> hub-item-title: "";
    in property <string> hub-item-kind-label: "";
    in property <bool> hub-item-enabled: true;
    // 0 = Builtin, 1 = QuickAction, 2 = CustomSlider, 3 = CustomGroup
    in property <int> hub-item-editor-mode: 0;
    in property <string> hub-quick-action-summary: "Nenhuma";
    in property <string> hub-slider-up-summary: "Nenhuma";
    in property <string> hub-slider-down-summary: "Nenhuma";
    in property <string> hub-slider-toggle-summary: "Nenhuma";
    in-out property <string> hub-slider-read: "";
    in property <int> hub-slider-step: 5;
    in property <bool> hub-slider-infinite: false;
    in property <[string]> hub-group-entry-labels: [];
    in property <int> hub-group-selected-entry: 0;
    in-out property <string> hub-group-entry-name: "";
    in property <string> hub-group-entry-icon-label: "Automático / nenhuma";
    in property <bool> hub-group-entry-is-slider: false;
    in property <string> hub-group-entry-action-summary: "Nenhuma";
    in property <string> hub-group-slider-up-summary: "Nenhuma";
    in property <string> hub-group-slider-down-summary: "Nenhuma";
    in property <string> hub-group-slider-toggle-summary: "Nenhuma";
    in-out property <string> hub-group-slider-read: "";
    in property <int> hub-group-slider-step: 5;
    in property <bool> hub-group-slider-infinite: false;
    in property <int> hub-volume-step: 5;
    in property <int> hub-brightness-step: 5;
    in property <int> hub-browse-timeout-sec: 5;
    in property <int> hub-adjust-timeout-sec: 10;
    in property <bool> hub-key3-is-confirm: true;
    in property <bool> hub-show-images: true;
    in property <bool> hub-animations-enabled: true;
    in property <string> hub-item-icon-label: "Automático / nenhuma";

    // --- Aba 2: Integrações (Providers) ---
    in property <bool> is-windows: false;
    in property <bool> obs-enabled: false;
    in-out property <string> obs-port: "4455";
    in-out property <string> obs-password: "";
    // 0 = Desconectado, 1 = Conectado, 2 = Indisponível
    in property <int> obs-status-code: 0;
    in property <string> obs-status-label: "Desconectado";
    in property <string> obs-status-detail: "";
    in property <bool> smtc-enabled: true;
    in property <bool> mpris-available: false;
    in property <string> mpris-status-label: "Indisponível";
    in property <string> mpris-status-detail: "";

    // --- Estado geral ---
    in property <bool> has-unsaved-changes: false;
    in-out property <string> error-message;

    // --- Popover de edição de ação ---
    in property <bool> editor-open: false;
    in property <string> editor-control-title;
    in property <string> editor-profile-context-label: "";
    in property <string> editor-inherited-hint: "";
    in property <int> editor-type-index: 0;
    in property <string> editor-preview-text: "";
    in-out property <string> editor-shortcut-text;
    in property <[string]> editor-shortcut-parts: [];
    in property <string> editor-active-preset-label: "";
    in property <bool> editor-preset-dropdown-open: false;
    in property <[string]> editor-preset-apps: [];
    in property <int> editor-preset-app-index: 0;
    in property <[PresetListItem]> editor-preset-items: [];
    in property <int> editor-media-index: 0;
    in-out property <string> editor-app-search;
    in property <[AppListItem]> editor-filtered-apps;
    in property <int> editor-selected-app-index: -1;
    in property <string> editor-selected-app-label: "";
    in-out property <string> editor-url-text;
    in-out property <string> editor-file-text;
    in-out property <string> editor-exec-text;
    in property <int> editor-scroll-direction: 0;
    in property <int> editor-scroll-amount: 1;
    in property <[MacroStepItem]> editor-macro-steps;
    in-out property <string> editor-macro-key-text;
    in-out property <string> editor-macro-wait-text: "100";
    in property <[ProviderOptionItem]> editor-provider-options: [];
    in property <int> editor-selected-provider-index: 0;
    in property <bool> editor-selected-provider-available: false;
    in property <[ProviderCommandItem]> editor-provider-commands: [];
    in property <int> editor-selected-provider-command-index: 0;
    in property <string> editor-provider-arg-label: "";
    in property <string> editor-provider-arg-placeholder: "";
    in-out property <string> editor-provider-arg-value: "";
    in property <string> editor-error-message;

    // Callbacks gerais e Aba 0
    callback select-tab(int);
    callback select-hub-subtab(int);
    callback select-profile(int);
    callback toggle-context-rules();
    callback add-profile();
    callback toggle-preset-picker();
    callback add-preset(int);
    callback remove-profile();
    callback capture-active-window();
    callback toggle-inherits-picker();
    callback select-inherits-option(int);
    callback navigate-inherits-chain(string);
    callback change-priority(int);
    callback toggle-fullscreen-only();
    callback open-action-editor(int);
    callback learn-action-slot(int);
    callback clear-action-slot(int);
    callback select-profile-subtab(int);
    callback profile-hub-customize();
    callback profile-hub-reset-inherit();
    callback profile-hub-select-module(int);
    callback profile-hub-move-module(int);
    callback profile-hub-remove-module();
    callback profile-hub-toggle-picker();
    callback profile-hub-add-template(int);
    callback save-requested();
    callback cancel-requested();

    // Callbacks Aba 1: Overlay / Hub
    callback hub-select-item(int);
    callback hub-move-item(int);
    callback hub-toggle-enabled();
    callback hub-add-quick-action();
    callback hub-add-custom-slider();
    callback hub-add-custom-group();
    callback hub-remove-item();
    callback hub-reset-defaults();
    callback hub-edit-quick-action();
    callback hub-edit-slider-action(int);
    callback hub-set-slider-infinite(bool);
    callback hub-change-slider-step(int);
    callback hub-group-select-entry(int);
    callback hub-group-add-entry();
    callback hub-group-add-slider();
    callback hub-group-remove-entry();
    callback hub-group-pick-entry-icon();
    callback hub-group-clear-entry-icon();
    callback hub-group-edit-entry-action();
    callback hub-group-edit-slider-action(int);
    callback hub-group-set-slider-infinite(bool);
    callback hub-group-change-slider-step(int);
    callback hub-change-volume-step(int);
    callback hub-change-brightness-step(int);
    callback hub-change-browse-timeout(int);
    callback hub-change-adjust-timeout(int);
    callback hub-toggle-key3-behavior();
    callback hub-toggle-show-images();
    callback hub-toggle-animations();
    callback hub-pick-item-icon();
    callback hub-clear-item-icon();

    // Callbacks Aba 2: Integrações
    callback obs-toggle-enabled();
    callback obs-test-connection();
    callback smtc-toggle-enabled();
    callback mpris-test-connection();

    // Callbacks Popover
    callback editor-select-type(int);
    callback editor-open-learn-shortcut();
    callback editor-shortcut-text-edited(string);
    callback editor-toggle-shortcut-modifier(string);
    callback editor-apply-shortcut-preset(string);
    callback editor-toggle-preset-dropdown();
    callback editor-select-preset-app(int);
    callback editor-select-preset-item(int);
    callback editor-clear-shortcut();
    callback editor-select-media(int);
    callback editor-app-search-changed(string);
    callback editor-select-app(int);
    callback editor-pick-file();
    callback editor-select-scroll-direction(int);
    callback editor-change-scroll-amount(int);
    callback editor-set-scroll-amount(int);
    callback editor-open-learn-macro();
    callback editor-add-macro-key();
    callback editor-add-macro-wait();
    callback editor-add-macro-wait-preset(int);
    callback editor-move-macro-step(int, int);
    callback editor-remove-macro-step(int);
    callback editor-select-provider(int);
    callback editor-select-provider-command(int);
    callback editor-provider-arg-edited(string);
    callback editor-save();
    callback editor-cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Barra superior: Navegação principal + indicador de alterações não salvas
        HorizontalLayout {
            spacing: 10px;
            alignment: space-between;

            SegmentedThree {
                width: 500px;
                height: 34px;
                first-label: "Perfis & Contexto";
                second-label: "Overlay / Hub";
                third-label: "Integrações";
                selected-index: root.active-tab;
                selected(i) => { root.select-tab(i); }
            }

            if root.has-unsaved-changes: Rectangle {
                height: 26px;
                y: 4px;
                border-radius: 13px;
                background: Theme.warning-soft;
                border-width: 1px;
                border-color: rgba(251, 191, 36, 0.35);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "• Alterações não salvas";
                        color: Theme.warning;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ==================== ABA 0: PERFIS & CONTEXTO ====================
        if root.active-tab == 0: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            // Coluna esquerda: lista de perfis enriquecida
            Rectangle {
                width: 224px;
                border-radius: 12px;
                background: Theme.bg-surface;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Perfis";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.profile-items.length + "";
                            color: Theme.text-dim;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.profile-items.length * 48px;

                        VerticalLayout {
                            spacing: 5px;
                            alignment: start;

                            for item[idx] in root.profile-items: Rectangle {
                                height: item.subtitle != "" ? 44px : 36px;
                                border-radius: 8px;
                                background: idx == root.selected-index
                                    ? Theme.accent-soft
                                    : (item-touch.has-hover ? rgba(255, 255, 255, 0.06) : Theme.bg-card);
                                border-width: 1px;
                                border-color: idx == root.selected-index
                                    ? Theme.border-accent
                                    : Theme.border-subtle;

                                animate background { duration: 100ms; easing: ease-out; }

                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    spacing: 1px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: space-between;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: item.name;
                                            color: idx == root.selected-index ? Theme.text-primary : Theme.text-secondary;
                                            font-size: 13px;
                                            font-weight: idx == root.selected-index ? 600 : 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        if item.is-global: Rectangle {
                                            height: 17px;
                                            border-radius: 4px;
                                            background: rgba(255, 255, 255, 0.08);
                                            HorizontalLayout {
                                                padding-left: 5px;
                                                padding-right: 5px;
                                                Text {
                                                    text: "Padrão";
                                                    color: Theme.text-muted;
                                                    font-size: 9px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if !item.is-global && item.has-custom-hub: Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            y: 5px;
                                            border-radius: 3px;
                                            background: Theme.accent;
                                        }
                                    }

                                    if item.subtitle != "": Text {
                                        text: item.subtitle;
                                        color: Theme.text-dim;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }

                                item-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-profile(idx); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        AppButton {
                            horizontal-stretch: 1;
                            text: "+ Novo";
                            clicked => { root.add-profile(); }
                        }

                        AppButton {
                            horizontal-stretch: 1;
                            text: "+ Preset";
                            clicked => { root.toggle-preset-picker(); }
                        }
                    }

                    AppButton {
                        text: "Remover perfil";
                        danger: true;
                        enabled: !root.selected-is-global;
                        clicked => { root.remove-profile(); }
                    }
                }
            }

            // Coluna direita: editor do perfil selecionado
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                border-radius: 12px;
                background: Theme.bg-surface;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // Banner limpo quando o perfil `global` está selecionado
                    if root.selected-is-global: Rectangle {
                        height: 52px;
                        border-radius: 9px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                y: 10px;
                                border-radius: 8px;
                                background: Theme.accent-soft;
                                border-width: 1px;
                                border-color: Theme.border-accent;
                                Text {
                                    text: "◎";
                                    color: Theme.accent-text;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Perfil Padrão (global)";
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Aplicado automaticamente quando nenhuma janela específica corresponder.";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Cabeçalho + Regras de ativação recolhíveis (apenas para perfis contextuais)
                    if !root.selected-is-global: VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 10px;

                            AppField {
                                horizontal-stretch: 2;
                                label: "Nome do perfil";
                                placeholder: "ex: video_web";
                                value <=> root.field-name;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: "Herda de";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 500;
                                }
                                AppButton {
                                    height: 32px;
                                    active: root.field-inherits-label != "Nenhum";
                                    text: root.field-inherits-label + " ▾";
                                    clicked => { root.toggle-inherits-picker(); }
                                }
                            }
                        }

                        // Cadeia de herança clicável
                        if root.inherits-chain.length > 1: HorizontalLayout {
                            spacing: 5px;
                            alignment: start;

                            Text {
                                text: "Cadeia:";
                                color: Theme.text-dim;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            for cname[cidx] in root.inherits-chain: HorizontalLayout {
                                spacing: 5px;

                                if cidx > 0: Text {
                                    text: "→";
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 20px;
                                    border-radius: 5px;
                                    background: cidx == root.inherits-chain.length - 1
                                        ? Theme.accent-soft
                                        : (chain-touch.has-hover ? rgba(255, 255, 255, 0.14) : rgba(255, 255, 255, 0.06));
                                    border-width: 1px;
                                    border-color: cidx == root.inherits-chain.length - 1
                                        ? Theme.border-accent
                                        : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 7px;
                                        padding-right: 7px;
                                        Text {
                                            text: cname;
                                            color: cidx == root.inherits-chain.length - 1 ? Theme.accent-text : Theme.text-secondary;
                                            font-size: 10px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    chain-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.navigate-inherits-chain(cname); }
                                    }
                                }
                            }
                        }

                        // Card recolhível de Regras de Ativação
                        Rectangle {
                            border-radius: 9px;
                            background: Theme.bg-card;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                // Cabeçalho clicável do acordeão
                                Rectangle {
                                    height: 22px;
                                    background: transparent;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: space-between;

                                        Text {
                                            text: (root.context-rules-expanded ? "▾ " : "▸ ") + "Regras de ativação";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        if !root.context-rules-expanded: Text {
                                            horizontal-stretch: 1;
                                            text: root.context-rules-summary;
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-context-rules(); }
                                    }
                                }

                                if root.context-rules-expanded: VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        AppField {
                                            horizontal-stretch: 1;
                                            label: "Classe da janela (WINDOWCLASS, use | para várias)";
                                            placeholder: "ex: firefox|zen|chromium";
                                            value <=> root.field-window-class;
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Detectar";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                            AppButton {
                                                width: 128px;
                                                height: 32px;
                                                text: "◎ Capturar janela";
                                                clicked => { root.capture-active-window(); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;

                                        AppField {
                                            horizontal-stretch: 1;
                                            label: "Título contém (opcional, use |)";
                                            placeholder: "ex: YouTube|Twitch|Netflix";
                                            value <=> root.field-window-title;
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Prioridade";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                            StepperControl {
                                                height: 32px;
                                                value-text: root.field-priority + "";
                                                decrement => { root.change-priority(-5); }
                                                increment => { root.change-priority(5); }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Só tela cheia";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                            HorizontalLayout {
                                                height: 32px;
                                                alignment: center;
                                                ToggleSwitch {
                                                    y: 6px;
                                                    checked: root.field-fullscreen-only;
                                                    toggled => { root.toggle-fullscreen-only(); }
                                                }
                                            }
                                        }
                                    }

                                    if root.captured-window-hint != "": Text {
                                        text: root.captured-window-hint;
                                        color: Theme.accent-text;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // Sub-abas do perfil via Segmented Control
                    SegmentedTwo {
                        first-label: "Ações do Knob";
                        second-label: root.profile-hub-subtab-label;
                        selected-index: root.profile-subtab;
                        selected(i) => { root.select-profile-subtab(i); }
                    }

                    // Sub-aba 0: Mapa Físico dos Controles (Opção A)
                    if root.profile-subtab == 0: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 10px;

                        // Seção Botão Rotativo
                        VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "BOTÃO ROTATIVO (KNOB)";
                                    color: Theme.text-dim;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "● Clique no knob abre o Hub Interativo";
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                RotaryControlCard {
                                    horizontal-stretch: 1;
                                    glyph: "↺";
                                    title: "Girar Anti-horário";
                                    slot: root.slot-rotate-ccw;
                                    learn-clicked => { root.learn-action-slot(1); }
                                    edit-clicked => { root.open-action-editor(1); }
                                    clear-clicked => { root.clear-action-slot(1); }
                                }

                                RotaryControlCard {
                                    horizontal-stretch: 1;
                                    glyph: "↻";
                                    title: "Girar Horário";
                                    slot: root.slot-rotate-cw;
                                    learn-clicked => { root.learn-action-slot(0); }
                                    edit-clicked => { root.open-action-editor(0); }
                                    clear-clicked => { root.clear-action-slot(0); }
                                }
                            }
                        }

                        // Seção Teclas Físicas
                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "TECLAS FÍSICAS";
                                color: Theme.text-dim;
                                font-size: 10px;
                                font-weight: 700;
                            }

                            PhysicalKeyRow {
                                key-code: "K1";
                                key-label: "Esquerda";
                                slot: root.slot-key1;
                                learn-clicked => { root.learn-action-slot(2); }
                                edit-clicked => { root.open-action-editor(2); }
                                clear-clicked => { root.clear-action-slot(2); }
                            }

                            PhysicalKeyRow {
                                key-code: "K2";
                                key-label: "Meio";
                                slot: root.slot-key2;
                                learn-clicked => { root.learn-action-slot(3); }
                                edit-clicked => { root.open-action-editor(3); }
                                clear-clicked => { root.clear-action-slot(3); }
                            }

                            PhysicalKeyRow {
                                key-code: "K3";
                                key-label: "Direita";
                                slot: root.slot-key3;
                                learn-clicked => { root.learn-action-slot(4); }
                                edit-clicked => { root.open-action-editor(4); }
                                clear-clicked => { root.clear-action-slot(4); }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // Sub-aba 1: Módulos do Hub deste perfil
                    if root.profile-subtab == 1: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;

                        Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: root.profile-hub-is-inherited
                                ? Theme.bg-card
                                : Theme.accent-soft;
                            border-width: 1px;
                            border-color: root.profile-hub-is-inherited
                                ? Theme.border-subtle
                                : Theme.border-accent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.profile-hub-status-text;
                                    color: root.profile-hub-is-inherited ? Theme.text-muted : Theme.accent-text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                if root.profile-hub-is-inherited: AppButton {
                                    y: 7px;
                                    height: 24px;
                                    font-size: 11px;
                                    primary: true;
                                    text: "Customizar";
                                    clicked => { root.profile-hub-customize(); }
                                }

                                if !root.profile-hub-is-inherited: AppButton {
                                    y: 7px;
                                    height: 24px;
                                    font-size: 11px;
                                    text: "Restaurar herança";
                                    clicked => { root.profile-hub-reset-inherit(); }
                                }
                            }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-height: root.profile-hub-module-labels.length * 36px;

                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                if root.profile-hub-module-labels.length == 0: Text {
                                    text: "Nenhum módulo configurado (o Hub não abrirá neste perfil).";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }

                                for mlabel[midx] in root.profile-hub-module-labels: Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    background: midx == root.profile-hub-selected-index
                                        ? Theme.accent-soft
                                        : (pmod-touch.has-hover ? rgba(255, 255, 255, 0.06) : Theme.bg-card);
                                    border-width: 1px;
                                    border-color: midx == root.profile-hub-selected-index
                                        ? Theme.border-accent
                                        : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: mlabel;
                                            color: root.profile-hub-is-inherited ? Theme.text-muted : Theme.text-primary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    pmod-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.profile-hub-select-module(midx); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            AppButton {
                                height: 28px;
                                text: "↑ Subir";
                                clicked => { root.profile-hub-move-module(-1); }
                            }

                            AppButton {
                                height: 28px;
                                text: "↓ Descer";
                                clicked => { root.profile-hub-move-module(1); }
                            }

                            AppButton {
                                horizontal-stretch: 1;
                                height: 28px;
                                primary: true;
                                text: "+ Adicionar módulo";
                                clicked => { root.profile-hub-toggle-picker(); }
                            }

                            AppButton {
                                height: 28px;
                                danger: true;
                                text: "Remover";
                                clicked => { root.profile-hub-remove-module(); }
                            }
                        }

                        if !root.profile-hub-is-inherited && root.profile-hub-module-labels.length > 0: AppField {
                            label: "Rótulo do módulo selecionado";
                            placeholder: "ex: Abas";
                            value <=> root.profile-hub-selected-title;
                        }
                    }
                }
            }
        }

        // ==================== ABA 1: OVERLAY / HUB ====================
        if root.active-tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                SegmentedTwo {
                    width: 420px;
                    first-label: "Itens Padrão do Hub";
                    second-label: "Aparência e Comportamento";
                    selected-index: root.hub-subtab;
                    selected(i) => { root.select-hub-subtab(i); }
                }

                Text {
                    text: "Usado pelo perfil global e por perfis sem módulos próprios.";
                    color: Theme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            // Sub-aba 0: Itens Padrão do Hub (altura total livre para editores!)
            if root.hub-subtab == 0: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 14px;

                // Coluna esquerda: lista de itens do Hub
                Rectangle {
                    width: 248px;
                    border-radius: 12px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 7px;

                        Text {
                            text: "Itens do Hub";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-height: root.hub-item-labels.length * 38px;

                            VerticalLayout {
                                spacing: 5px;
                                alignment: start;

                                for label[idx] in root.hub-item-labels: Rectangle {
                                    height: 33px;
                                    border-radius: 8px;
                                    background: idx == root.hub-selected-index
                                        ? Theme.accent-soft
                                        : (hub-touch.has-hover ? rgba(255, 255, 255, 0.06) : Theme.bg-card);
                                    border-width: 1px;
                                    border-color: idx == root.hub-selected-index
                                        ? Theme.border-accent
                                        : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;

                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            y: 13px;
                                            border-radius: 4px;
                                            background: root.hub-item-enabled-flags[idx]
                                                ? Theme.success
                                                : Theme.text-dim;
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: label;
                                            color: idx == root.hub-selected-index ? Theme.text-primary : Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: idx == root.hub-selected-index ? 600 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    hub-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.hub-select-item(idx); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            AppButton {
                                horizontal-stretch: 1;
                                text: "↑ Subir";
                                clicked => { root.hub-move-item(-1); }
                            }
                            AppButton {
                                horizontal-stretch: 1;
                                text: "↓ Descer";
                                clicked => { root.hub-move-item(1); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            AppButton {
                                horizontal-stretch: 1;
                                font-size: 11px;
                                text: "+ Ação";
                                clicked => { root.hub-add-quick-action(); }
                            }
                            AppButton {
                                horizontal-stretch: 1;
                                font-size: 11px;
                                text: "+ Slider";
                                clicked => { root.hub-add-custom-slider(); }
                            }
                            AppButton {
                                horizontal-stretch: 1;
                                font-size: 11px;
                                text: "+ Grupo";
                                clicked => { root.hub-add-custom-group(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            AppButton {
                                horizontal-stretch: 1;
                                text: "Padrão";
                                clicked => { root.hub-reset-defaults(); }
                            }
                            AppButton {
                                horizontal-stretch: 1;
                                danger: true;
                                text: "Remover";
                                clicked => { root.hub-remove-item(); }
                            }
                        }
                    }
                }

                // Coluna direita: editor do item selecionado
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    border-radius: 12px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 12px;

                            AppField {
                                horizontal-stretch: 1;
                                label: "Título do item (" + root.hub-item-kind-label + ")";
                                placeholder: "ex: Sons & Apps";
                                value <=> root.hub-item-title;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Visível no Hub";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 500;
                                }
                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 8px;
                                    alignment: start;

                                    ToggleSwitch {
                                        y: 6px;
                                        checked: root.hub-item-enabled;
                                        toggled => { root.hub-toggle-enabled(); }
                                    }

                                    Text {
                                        text: root.hub-item-enabled ? "Ativo" : "Oculto";
                                        color: root.hub-item-enabled ? Theme.text-primary : Theme.text-dim;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Imagem opcional do item
                        Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: Theme.bg-card;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;

                                Text {
                                    text: "Imagem opcional:";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.hub-item-icon-label;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                AppButton {
                                    y: 7px;
                                    height: 24px;
                                    font-size: 11px;
                                    text: "Escolher...";
                                    clicked => { root.hub-pick-item-icon(); }
                                }
                                AppButton {
                                    y: 7px;
                                    height: 24px;
                                    font-size: 11px;
                                    ghost: true;
                                    text: "Limpar";
                                    clicked => { root.hub-clear-item-icon(); }
                                }
                            }
                        }

                        // Modo 0: Módulo nativo embutido
                        if root.hub-item-editor-mode == 0: Rectangle {
                            vertical-stretch: 1;
                            border-radius: 10px;
                            background: Theme.bg-card;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 20px;
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "Módulo nativo: " + root.hub-item-kind-label;
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Você pode renomear, reordenar, atribuir uma imagem ou ocultar este módulo no Hub.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Modo 1: Ação Rápida
                        if root.hub-item-editor-mode == 1: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 10px;
                            SimpleActionRow {
                                control-label: "Ação ao confirmar";
                                action-summary: root.hub-quick-action-summary;
                                edit-clicked => { root.hub-edit-quick-action(); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }

                        // Modo 2: Slider Customizado
                        if root.hub-item-editor-mode == 2: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;

                            SegmentedTwo {
                                first-label: "Porcentagem (0–100%)";
                                second-label: "Girar Infinito (∞)";
                                selected-index: root.hub-slider-infinite ? 1 : 0;
                                selected(i) => { root.hub-set-slider-infinite(i == 1); }
                            }

                            SimpleActionRow {
                                control-label: "↻ Girar horário (+)";
                                action-summary: root.hub-slider-up-summary;
                                edit-clicked => { root.hub-edit-slider-action(0); }
                            }
                            SimpleActionRow {
                                control-label: "↺ Girar anti-horário (-)";
                                action-summary: root.hub-slider-down-summary;
                                edit-clicked => { root.hub-edit-slider-action(1); }
                            }
                            SimpleActionRow {
                                control-label: "K2 / Toggle (opcional)";
                                action-summary: root.hub-slider-toggle-summary;
                                edit-clicked => { root.hub-edit-slider-action(2); }
                            }
                            if !root.hub-slider-infinite: HorizontalLayout {
                                spacing: 10px;
                                AppField {
                                    horizontal-stretch: 1;
                                    label: "Leitura 0-100 (comando shell opcional)";
                                    placeholder: "ex: echo 50";
                                    value <=> root.hub-slider-read;
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Passo visual";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                    StepperControl {
                                        height: 32px;
                                        value-text: root.hub-slider-step + "%";
                                        decrement => { root.hub-change-slider-step(-1); }
                                        increment => { root.hub-change-slider-step(1); }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }

                        // Modo 3: Submenu Customizado
                        if root.hub-item-editor-mode == 3: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Entradas do submenu";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                AppButton {
                                    height: 26px;
                                    primary: true;
                                    font-size: 11px;
                                    text: "+ Ação";
                                    clicked => { root.hub-group-add-entry(); }
                                }
                                AppButton {
                                    height: 26px;
                                    primary: true;
                                    font-size: 11px;
                                    text: "+ Slider";
                                    clicked => { root.hub-group-add-slider(); }
                                }
                                AppButton {
                                    height: 26px;
                                    danger: true;
                                    font-size: 11px;
                                    text: "Remover";
                                    clicked => { root.hub-group-remove-entry(); }
                                }
                            }

                            Flickable {
                                vertical-stretch: 1;
                                content-height: root.hub-group-entry-labels.length * 36px;

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    for elabel[eidx] in root.hub-group-entry-labels: Rectangle {
                                        height: 32px;
                                        border-radius: 7px;
                                        background: eidx == root.hub-group-selected-entry
                                            ? Theme.accent-soft
                                            : Theme.bg-card;
                                        border-width: 1px;
                                        border-color: eidx == root.hub-group-selected-entry
                                            ? Theme.border-accent
                                            : Theme.border-subtle;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: elabel;
                                                color: Theme.text-primary;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.hub-group-select-entry(eidx); }
                                        }
                                    }
                                }
                            }

                            if root.hub-group-entry-labels.length > 0: VerticalLayout {
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 10px;

                                    AppField {
                                        horizontal-stretch: 1;
                                        label: root.hub-group-entry-is-slider
                                            ? "Nome do slider selecionado"
                                            : "Nome da entrada selecionada";
                                        placeholder: root.hub-group-entry-is-slider
                                            ? "ex: Zoom da Tela"
                                            : "ex: Abrir Obsidian";
                                        value <=> root.hub-group-entry-name;
                                    }

                                    if root.hub-group-entry-is-slider && !root.hub-group-slider-infinite: VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: "Passo";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: 500;
                                        }
                                        StepperControl {
                                            height: 32px;
                                            value-text: root.hub-group-slider-step + "%";
                                            decrement => { root.hub-group-change-slider-step(-1); }
                                            increment => { root.hub-group-change-slider-step(1); }
                                        }
                                    }
                                }

                                // Imagem opcional para a entrada selecionada (Ação ou Slider)
                                Rectangle {
                                    height: 34px;
                                    border-radius: 7px;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        Text {
                                            text: "Imagem:";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.hub-group-entry-icon-label;
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        AppButton {
                                            y: 5px;
                                            height: 24px;
                                            font-size: 11px;
                                            text: "Escolher...";
                                            clicked => { root.hub-group-pick-entry-icon(); }
                                        }
                                        AppButton {
                                            y: 5px;
                                            height: 24px;
                                            font-size: 11px;
                                            ghost: true;
                                            text: "Limpar";
                                            clicked => { root.hub-group-clear-entry-icon(); }
                                        }
                                    }
                                }

                                if !root.hub-group-entry-is-slider: SimpleActionRow {
                                    control-label: "Ação da entrada";
                                    action-summary: root.hub-group-entry-action-summary;
                                    edit-clicked => { root.hub-group-edit-entry-action(); }
                                }

                                if root.hub-group-entry-is-slider: VerticalLayout {
                                    spacing: 5px;

                                    SegmentedTwo {
                                        height: 28px;
                                        first-label: "Porcentagem (0–100%)";
                                        second-label: "Girar Infinito (∞)";
                                        selected-index: root.hub-group-slider-infinite ? 1 : 0;
                                        selected(i) => { root.hub-group-set-slider-infinite(i == 1); }
                                    }

                                    SimpleActionRow {
                                        control-label: "↻ Girar horário (+)";
                                        action-summary: root.hub-group-slider-up-summary;
                                        edit-clicked => { root.hub-group-edit-slider-action(0); }
                                    }
                                    SimpleActionRow {
                                        control-label: "↺ Girar anti-horário (-)";
                                        action-summary: root.hub-group-slider-down-summary;
                                        edit-clicked => { root.hub-group-edit-slider-action(1); }
                                    }
                                    SimpleActionRow {
                                        control-label: "K2 / Toggle (opcional)";
                                        action-summary: root.hub-group-slider-toggle-summary;
                                        edit-clicked => { root.hub-group-edit-slider-action(2); }
                                    }
                                    if !root.hub-group-slider-infinite: AppField {
                                        label: "Leitura 0-100 (comando shell opcional)";
                                        placeholder: "ex: echo 50";
                                        value <=> root.hub-group-slider-read;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Sub-aba 1: Aparência e Comportamento (Cards limpos com Switches e Steppers)
            if root.hub-subtab == 1: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 14px;

                // Card 1: Sensibilidade e Timeouts
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 12px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Sensibilidade e Timeouts";
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Controle o incremento por giro e o tempo de fechamento automático do Hub.";
                                color: Theme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Passo de volume"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                                Text { text: "Incremento ao girar no Mixer de Áudio"; color: Theme.text-dim; font-size: 11px; }
                            }
                            StepperControl {
                                y: 4px;
                                value-text: root.hub-volume-step + "%";
                                decrement => { root.hub-change-volume-step(-1); }
                                increment => { root.hub-change-volume-step(1); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Passo de brilho"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                                Text { text: "Incremento ao ajustar brilho dos monitores"; color: Theme.text-dim; font-size: 11px; }
                            }
                            StepperControl {
                                y: 4px;
                                value-text: root.hub-brightness-step + "%";
                                decrement => { root.hub-change-brightness-step(-1); }
                                increment => { root.hub-change-brightness-step(1); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Timeout ao navegar"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                                Text { text: "Fecha o Hub após inatividade navegando"; color: Theme.text-dim; font-size: 11px; }
                            }
                            StepperControl {
                                y: 4px;
                                value-text: root.hub-browse-timeout-sec + "s";
                                decrement => { root.hub-change-browse-timeout(-1); }
                                increment => { root.hub-change-browse-timeout(1); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Timeout ajustando slider"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                                Text { text: "Mantém o Hub aberto por mais tempo no modo ajuste"; color: Theme.text-dim; font-size: 11px; }
                            }
                            StepperControl {
                                y: 4px;
                                value-text: root.hub-adjust-timeout-sec + "s";
                                decrement => { root.hub-change-adjust-timeout(-1); }
                                increment => { root.hub-change-adjust-timeout(1); }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Card 2: Interação e Visual
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 12px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 18px;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Interação e Visual";
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Personalize animações, miniaturas e o papel da tecla K3 com o Hub aberto.";
                                color: Theme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Miniaturas e ícones de apps"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                                Text { text: "Exibe thumbnails de wallpapers e ícones .desktop no carrossel"; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
                            }
                            ToggleSwitch {
                                y: 8px;
                                checked: root.hub-show-images;
                                toggled => { root.hub-toggle-show-images(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Animações suaves (60fps)"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                                Text { text: "Transições contínuas ao girar o carrossel e abrir o overlay"; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
                            }
                            ToggleSwitch {
                                y: 8px;
                                checked: root.hub-animations-enabled;
                                toggled => { root.hub-toggle-animations(); }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            Text { text: "Comportamento da tecla K3 no Hub"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                            Text { text: "Define o que a tecla direita (K3) faz enquanto o overlay está aberto."; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }

                            SegmentedTwo {
                                first-label: "Confirmar / Travar";
                                second-label: "Fechar Hub";
                                selected-index: root.hub-key3-is-confirm ? 0 : 1;
                                selected(i) => {
                                    if (i == 0 && !root.hub-key3-is-confirm) || (i == 1 && root.hub-key3-is-confirm) {
                                        root.hub-toggle-key3-behavior();
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // ==================== ABA 2: INTEGRAÇÕES (PROVIDERS) ====================
        if root.active-tab == 2: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            // Card 1: OBS Studio (obs-websocket 5.x)
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                background: Theme.bg-surface;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "OBS Studio";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Controle direto via obs-websocket 5.x (localhost)";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }

                        Rectangle {
                            height: 24px;
                            y: 4px;
                            border-radius: 6px;
                            background: root.obs-status-code == 1
                                ? Theme.success-soft
                                : (root.obs-status-code == 2 ? Theme.danger-soft : rgba(255, 255, 255, 0.06));
                            border-width: 1px;
                            border-color: root.obs-status-code == 1
                                ? rgba(34, 197, 94, 0.42)
                                : (root.obs-status-code == 2 ? Theme.danger-border : Theme.border-subtle);

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.obs-status-label;
                                    color: root.obs-status-code == 1
                                        ? #86efac
                                        : (root.obs-status-code == 2 ? Theme.danger-text : Theme.text-muted);
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: "Habilitar OBS WebSocket"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                            Text { text: "Conexão preguiçosa: só conecta ao executar um comando ou testar"; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
                        }
                        ToggleSwitch {
                            y: 8px;
                            checked: root.obs-enabled;
                            toggled => { root.obs-toggle-enabled(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        AppField {
                            width: 120px;
                            label: "Porta";
                            placeholder: "4455";
                            value <=> root.obs-port;
                        }
                        AppField {
                            horizontal-stretch: 1;
                            label: "Senha (opcional)";
                            placeholder: "Vazio se sem autenticação";
                            value <=> root.obs-password;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        AppButton {
                            primary: true;
                            text: "Testar conexão";
                            clicked => { root.obs-test-connection(); }
                        }
                    }

                    if root.obs-status-detail != "": Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding: 10px;
                            Text {
                                text: root.obs-status-detail;
                                color: root.obs-status-code == 1
                                    ? #86efac
                                    : (root.obs-status-code == 2 ? Theme.danger-text : Theme.text-secondary);
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: "No OBS: Ferramentas → Configurações do Servidor WebSocket (porta padrão 4455).";
                        color: Theme.text-dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // Card 2: Mídia Nativa (Windows: SMTC | Linux: MPRIS)
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                background: Theme.bg-surface;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: root.is-windows ? "Mídia Windows (SMTC)" : "Mídia (MPRIS)";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.is-windows
                                    ? "Protocolo nativo Windows (System Media Transport Controls)"
                                    : "Protocolo padrão Linux via D-Bus (sem configuração)";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }

                        Rectangle {
                            height: 24px;
                            y: 4px;
                            border-radius: 6px;
                            background: root.mpris-available ? Theme.success-soft : rgba(255, 255, 255, 0.06);
                            border-width: 1px;
                            border-color: root.mpris-available ? rgba(34, 197, 94, 0.42) : Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.mpris-status-label;
                                    color: root.mpris-available ? #86efac : Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.is-windows
                            ? "Controla diretamente Spotify, Firefox/Chrome (YouTube/Twitch) e players nativos do Windows, com capa do álbum no Hub e no Mini-HUD."
                            : "Controla diretamente qualquer player compatível com MPRIS em execução (Spotify, Firefox, Chromium, mpv, VLC) sem depender de atalhos de teclado.";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    if root.is-windows: HorizontalLayout {
                        spacing: 10px;
                        alignment: space-between;
                        Text {
                            text: "Ativar provider SMTC ([providers.smtc])";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        ToggleSwitch {
                            checked: root.smtc-enabled;
                            toggled => { root.smtc-toggle-enabled(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        AppButton {
                            text: root.is-windows ? "Verificar sessões SMTC" : "Verificar players";
                            clicked => { root.mpris-test-connection(); }
                        }
                    }

                    if root.mpris-status-detail != "": Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding: 10px;
                            Text {
                                text: root.mpris-status-detail;
                                color: root.mpris-available ? #86efac : Theme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: "Comandos disponíveis no Seletor de Ações";
                                color: Theme.text-secondary;
                                font-size: 11px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.is-windows
                                    ? "• Play / Pause  • Reproduzir  • Pausar  • Próxima faixa  • Faixa anterior  • Avançar / retroceder (segundos)"
                                    : "• Play / Pause  • Próxima faixa  • Faixa anterior  • Parar  • Avançar / retroceder (segundos)";
                                color: Theme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        // Mensagem de erro global
        if root.error-message != "": Rectangle {
            border-radius: 8px;
            background: Theme.danger-soft;
            border-width: 1px;
            border-color: Theme.danger-border;

            HorizontalLayout {
                padding: 8px;
                Text {
                    text: root.error-message;
                    color: Theme.danger-text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        // Rodapé global: Cancelar / Salvar
        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            AppButton {
                text: "Cancelar";
                clicked => { root.cancel-requested(); }
            }

            AppButton {
                text: "Salvar";
                primary: true;
                clicked => { root.save-requested(); }
            }
        }
    }

    // ==================== MODAL: HERDA DE ====================
    if root.inherits-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-scrim;

        TouchArea {
            clicked => { root.toggle-inherits-picker(); }
        }

        Rectangle {
            width: 360px;
            height: 340px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.bg-window;
            border-width: 1px;
            border-color: Theme.border-default;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Herda de";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    AppButton {
                        width: 26px;
                        height: 26px;
                        ghost: true;
                        text: "×";
                        font-size: 15px;
                        clicked => { root.toggle-inherits-picker(); }
                    }
                }

                Text {
                    text: "Ações definidas como 'Nenhuma' serão herdadas do perfil escolhido:";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Flickable {
                    vertical-stretch: 1;
                    content-height: root.inherits-options.length * 38px;

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        for opt[oidx] in root.inherits-options: AppButton {
                            height: 32px;
                            active: opt == root.field-inherits-label;
                            text: opt;
                            clicked => { root.select-inherits-option(oidx); }
                        }
                    }
                }
            }
        }
    }

    // ==================== MODAL: ADICIONAR MÓDULO AO HUB ====================
    if root.profile-hub-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-scrim;

        TouchArea {
            clicked => { root.profile-hub-toggle-picker(); }
        }

        Rectangle {
            width: 400px;
            height: 400px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.bg-window;
            border-width: 1px;
            border-color: Theme.border-default;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Adicionar Módulo ao Hub";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    AppButton {
                        width: 26px;
                        height: 26px;
                        ghost: true;
                        text: "×";
                        font-size: 15px;
                        clicked => { root.profile-hub-toggle-picker(); }
                    }
                }

                Text {
                    text: "Escolha um módulo nativo para adicionar a este perfil:";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Flickable {
                    vertical-stretch: 1;
                    content-height: root.profile-hub-template-labels.length * 36px;

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        for tlabel[tidx] in root.profile-hub-template-labels: AppButton {
                            height: 30px;
                            text: tlabel;
                            clicked => { root.profile-hub-add-template(tidx); }
                        }
                    }
                }
            }
        }
    }

    // ==================== MODAL: PRESETS CONTEXTUAIS ====================
    if root.preset-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-scrim;

        TouchArea {
            clicked => { root.toggle-preset-picker(); }
        }

        Rectangle {
            width: 440px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.bg-window;
            border-width: 1px;
            border-color: Theme.border-default;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Adicionar Preset Contextual";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    AppButton {
                        width: 26px;
                        height: 26px;
                        ghost: true;
                        text: "×";
                        font-size: 15px;
                        clicked => { root.toggle-preset-picker(); }
                    }
                }

                Text {
                    text: "Escolha um comportamento pronto para adicionar aos seus perfis:";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Flickable {
                    vertical-stretch: 1;
                    content-height: root.preset-labels.length * 40px;

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        for label[idx] in root.preset-labels: AppButton {
                            height: 34px;
                            text: label;
                            clicked => { root.add-preset(idx); }
                        }
                    }
                }
            }
        }
    }

    // ==================== POPOVER: SELETOR DE AÇÕES ====================
    if root.editor-open: ActionEditorPopover {
        width: 100%;
        height: 100%;
        control-title: root.editor-control-title;
        profile-context-label: root.editor-profile-context-label;
        inherited-hint: root.editor-inherited-hint;
        selected-type-index: root.editor-type-index;
        preview-text: root.editor-preview-text;
        shortcut-text <=> root.editor-shortcut-text;
        shortcut-parts: root.editor-shortcut-parts;
        active-preset-label: root.editor-active-preset-label;
        preset-dropdown-open: root.editor-preset-dropdown-open;
        preset-apps: root.editor-preset-apps;
        preset-app-index: root.editor-preset-app-index;
        preset-items: root.editor-preset-items;
        selected-media-index: root.editor-media-index;
        app-search <=> root.editor-app-search;
        filtered-apps: root.editor-filtered-apps;
        selected-app-index: root.editor-selected-app-index;
        selected-app-label: root.editor-selected-app-label;
        url-text <=> root.editor-url-text;
        file-text <=> root.editor-file-text;
        exec-text <=> root.editor-exec-text;
        scroll-direction-index: root.editor-scroll-direction;
        scroll-amount: root.editor-scroll-amount;
        macro-steps: root.editor-macro-steps;
        macro-key-text <=> root.editor-macro-key-text;
        macro-wait-text <=> root.editor-macro-wait-text;
        provider-options: root.editor-provider-options;
        selected-provider-index: root.editor-selected-provider-index;
        selected-provider-available: root.editor-selected-provider-available;
        provider-commands: root.editor-provider-commands;
        selected-provider-command-index: root.editor-selected-provider-command-index;
        provider-arg-label: root.editor-provider-arg-label;
        provider-arg-placeholder: root.editor-provider-arg-placeholder;
        provider-arg-value <=> root.editor-provider-arg-value;
        error-message: root.editor-error-message;

        select-type(i) => { root.editor-select-type(i); }
        open-learn-shortcut => { root.editor-open-learn-shortcut(); }
        shortcut-text-edited(v) => { root.editor-shortcut-text-edited(v); }
        toggle-shortcut-modifier(m) => { root.editor-toggle-shortcut-modifier(m); }
        apply-shortcut-preset(p) => { root.editor-apply-shortcut-preset(p); }
        toggle-preset-dropdown => { root.editor-toggle-preset-dropdown(); }
        select-preset-app(i) => { root.editor-select-preset-app(i); }
        select-preset-item(i) => { root.editor-select-preset-item(i); }
        clear-shortcut => { root.editor-clear-shortcut(); }
        select-media(i) => { root.editor-select-media(i); }
        app-search-changed(q) => { root.editor-app-search-changed(q); }
        select-app(i) => { root.editor-select-app(i); }
        pick-file => { root.editor-pick-file(); }
        select-scroll-direction(i) => { root.editor-select-scroll-direction(i); }
        change-scroll-amount(d) => { root.editor-change-scroll-amount(d); }
        set-scroll-amount(v) => { root.editor-set-scroll-amount(v); }
        open-learn-macro => { root.editor-open-learn-macro(); }
        add-macro-key => { root.editor-add-macro-key(); }
        add-macro-wait => { root.editor-add-macro-wait(); }
        add-macro-wait-preset(ms) => { root.editor-add-macro-wait-preset(ms); }
        move-macro-step(idx, d) => { root.editor-move-macro-step(idx, d); }
        remove-macro-step(i) => { root.editor-remove-macro-step(i); }
        select-provider(i) => { root.editor-select-provider(i); }
        select-provider-command(i) => { root.editor-select-provider-command(i); }
        provider-arg-edited(v) => { root.editor-provider-arg-edited(v); }
        save-action => { root.editor-save(); }
        cancel-action => { root.editor-cancel(); }
    }
}
