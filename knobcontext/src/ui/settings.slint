import { ActionEditorPopover } from "action_editor.slint";

component DarkField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;

    height: 54px;
    background: transparent;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: root.label;
            color: #a1a1aa;
            font-size: 11px;
            font-weight: 500;
        }

        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: rgba(18, 18, 18, 0.95);
            border-width: 1px;
            border-color: input.has-focus ? rgba(255, 255, 255, 0.45) : rgba(255, 255, 255, 0.12);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: stretch;

                input := TextInput {
                    text <=> root.value;
                    color: #f5f5f7;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                }
            }

            if root.value == "" && !input.has-focus: Text {
                x: 10px;
                text: root.placeholder;
                color: rgba(255, 255, 255, 0.28);
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

component DarkButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: root.primary
        ? (touch.has-hover ? #3b82f6 : #2563eb)
        : (root.danger
            ? (touch.has-hover ? rgba(220, 38, 38, 0.35) : rgba(220, 38, 38, 0.2))
            : (touch.has-hover ? rgba(255, 255, 255, 0.14) : rgba(255, 255, 255, 0.08)));
    border-width: 1px;
    border-color: root.primary
        ? rgba(147, 197, 253, 0.4)
        : (root.danger ? rgba(248, 113, 113, 0.35) : rgba(255, 255, 255, 0.12));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            color: #f5f5f7;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ActionRow inherits Rectangle {
    in property <string> control-label;
    in property <string> action-summary;
    callback edit-clicked();

    height: 38px;
    border-radius: 7px;
    background: rgba(18, 18, 20, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        alignment: stretch;

        Text {
            width: 155px;
            text: root.control-label;
            color: #d4d4d8;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.action-summary;
            color: #f5f5f7;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        DarkButton {
            width: 68px;
            height: 25px;
            text: "Editar";
            clicked => { root.edit-clicked(); }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "KnobContext Settings";
    width: 840px;
    height: 650px;
    background: rgba(20, 20, 20, 0.94);

    // Aba ativa: 0 = Perfis & Contexto, 1 = Overlay / Hub
    in property <int> active-tab: 0;

    // --- Aba 0: Perfis & Contexto ---
    in property <[string]> profile-names: ["global"];
    in property <[string]> preset-labels: [];
    in property <bool> preset-picker-open: false;
    in property <int> selected-index: 0;
    in-out property <string> field-name;
    in-out property <string> field-window-class;
    in-out property <string> field-window-title;
    in-out property <string> field-inherits;
    in property <int> field-priority: 0;
    in property <bool> field-fullscreen-only: false;
    in property <string> captured-window-hint: "";
    in property <string> summary-rotate-cw: "Nenhuma";
    in property <string> summary-rotate-ccw: "Nenhuma";
    in property <string> summary-key1: "Nenhuma";
    in property <string> summary-key2: "Nenhuma";
    in property <string> summary-key3: "Nenhuma";

    // --- Aba 1: Overlay / Hub ---
    in property <[string]> hub-item-labels: [];
    in property <int> hub-selected-index: 0;
    in-out property <string> hub-item-title: "";
    in property <string> hub-item-kind-label: "";
    in property <bool> hub-item-enabled: true;
    // 0 = Builtin, 1 = QuickAction, 2 = CustomSlider, 3 = CustomGroup
    in property <int> hub-item-editor-mode: 0;
    in property <string> hub-quick-action-summary: "Nenhuma";
    in-out property <string> hub-slider-up: "";
    in-out property <string> hub-slider-down: "";
    in-out property <string> hub-slider-toggle: "";
    in-out property <string> hub-slider-read: "";
    in property <int> hub-slider-step: 5;
    in property <[string]> hub-group-entry-labels: [];
    in property <int> hub-group-selected-entry: 0;
    in-out property <string> hub-group-entry-name: "";
    in property <string> hub-group-entry-action-summary: "Nenhuma";
    in property <int> hub-volume-step: 5;
    in property <int> hub-brightness-step: 5;
    in property <int> hub-browse-timeout-sec: 5;
    in property <int> hub-adjust-timeout-sec: 10;
    in property <bool> hub-key3-is-confirm: true;
    in property <bool> hub-show-images: true;
    in property <bool> hub-animations-enabled: true;
    in property <string> hub-item-icon-label: "Automático / nenhuma";

    // --- Estado geral ---
    in property <bool> has-unsaved-changes: false;
    in-out property <string> error-message;

    // --- Popover de edição de ação ---
    in property <bool> editor-open: false;
    in property <string> editor-control-title;
    in property <[string]> editor-type-titles;
    in property <int> editor-type-index: 0;
    in-out property <string> editor-shortcut-text;
    in property <bool> editor-capturing-shortcut: false;
    in property <int> editor-media-index: 0;
    in-out property <string> editor-app-search;
    in property <[string]> editor-filtered-apps;
    in property <int> editor-selected-app-index: -1;
    in-out property <string> editor-url-text;
    in-out property <string> editor-file-text;
    in-out property <string> editor-exec-text;
    in property <int> editor-scroll-direction: 0;
    in property <int> editor-scroll-amount: 1;
    in property <[string]> editor-macro-steps;
    in-out property <string> editor-macro-key-text;
    in-out property <string> editor-macro-wait-text: "100";
    in property <bool> editor-capturing-macro: false;
    in property <string> editor-error-message;

    // Callbacks gerais e Aba 0
    callback select-tab(int);
    callback select-profile(int);
    callback add-profile();
    callback toggle-preset-picker();
    callback add-preset(int);
    callback remove-profile();
    callback capture-active-window();
    callback change-priority(int);
    callback toggle-fullscreen-only();
    callback open-action-editor(int);
    callback save-requested();
    callback cancel-requested();

    // Callbacks Aba 1: Overlay / Hub
    callback hub-select-item(int);
    callback hub-move-item(int);
    callback hub-toggle-enabled();
    callback hub-add-quick-action();
    callback hub-add-custom-slider();
    callback hub-add-custom-group();
    callback hub-remove-item();
    callback hub-reset-defaults();
    callback hub-edit-quick-action();
    callback hub-change-slider-step(int);
    callback hub-group-select-entry(int);
    callback hub-group-add-entry();
    callback hub-group-remove-entry();
    callback hub-group-edit-entry-action();
    callback hub-change-volume-step(int);
    callback hub-change-brightness-step(int);
    callback hub-change-browse-timeout(int);
    callback hub-change-adjust-timeout(int);
    callback hub-toggle-key3-behavior();
    callback hub-toggle-show-images();
    callback hub-toggle-animations();
    callback hub-pick-item-icon();
    callback hub-clear-item-icon();

    // Callbacks Popover
    callback editor-select-type(int);
    callback editor-toggle-shortcut-capture();
    callback editor-shortcut-key-captured(string, bool, bool, bool, bool);
    callback editor-select-media(int);
    callback editor-app-search-changed(string);
    callback editor-select-app(int);
    callback editor-pick-file();
    callback editor-select-scroll-direction(int);
    callback editor-change-scroll-amount(int);
    callback editor-toggle-macro-capture();
    callback editor-macro-key-captured(string, bool, bool, bool, bool);
    callback editor-add-macro-key();
    callback editor-add-macro-wait();
    callback editor-remove-macro-step(int);
    callback editor-save();
    callback editor-cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // Barra superior de abas + indicador de alterações
        HorizontalLayout {
            spacing: 8px;
            alignment: stretch;

            DarkButton {
                width: 170px;
                primary: root.active-tab == 0;
                text: "Perfis & Contexto";
                clicked => { root.select-tab(0); }
            }

            DarkButton {
                width: 170px;
                primary: root.active-tab == 1;
                text: "Overlay / Hub";
                clicked => { root.select-tab(1); }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            if root.has-unsaved-changes: Text {
                text: "• alterações não salvas";
                color: #fbbf24;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // ==================== ABA 0: PERFIS & CONTEXTO ====================
        if root.active-tab == 0: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            // Coluna esquerda: lista de perfis
            Rectangle {
                width: 210px;
                border-radius: 10px;
                background: rgba(30, 30, 30, 0.9);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.1);

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Perfis";
                        color: #f5f5f7;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.profile-names.length * 40px;

                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            for name[idx] in root.profile-names: Rectangle {
                                height: 34px;
                                border-radius: 7px;
                                background: idx == root.selected-index
                                    ? rgba(255, 255, 255, 0.18)
                                    : (item-touch.has-hover ? rgba(255, 255, 255, 0.08) : rgba(255, 255, 255, 0.03));
                                border-width: 1px;
                                border-color: idx == root.selected-index
                                    ? rgba(255, 255, 255, 0.35)
                                    : rgba(255, 255, 255, 0.06);

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: name;
                                        color: idx == root.selected-index ? #ffffff : #d4d4d8;
                                        font-size: 13px;
                                        font-weight: idx == root.selected-index ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                item-touch := TouchArea {
                                    clicked => { root.select-profile(idx); }
                                }
                            }
                        }
                    }

                    DarkButton {
                        text: "+ Adicionar perfil";
                        clicked => { root.add-profile(); }
                    }

                    DarkButton {
                        text: root.preset-picker-open ? "Fechar presets" : "+ Preset contextual";
                        clicked => { root.toggle-preset-picker(); }
                    }

                    DarkButton {
                        text: "Remover perfil";
                        danger: true;
                        clicked => { root.remove-profile(); }
                    }
                }
            }

            // Coluna direita: editor do perfil selecionado
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 10px;
                background: rgba(30, 30, 30, 0.9);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.1);

                VerticalLayout {
                    padding: 14px;
                    spacing: 7px;

                    HorizontalLayout {
                        spacing: 10px;

                        DarkField {
                            horizontal-stretch: 1;
                            label: "Nome do perfil";
                            placeholder: "ex: video_web";
                            value <=> root.field-name;
                        }

                        DarkField {
                            horizontal-stretch: 2;
                            label: "Janela (WINDOWCLASS, use | para várias)";
                            placeholder: "ex: firefox|zen|chromium";
                            value <=> root.field-window-class;
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Detectar";
                                color: #a1a1aa;
                                font-size: 11px;
                                font-weight: 500;
                            }
                            DarkButton {
                                width: 100px;
                                height: 32px;
                                text: "Capturar";
                                clicked => { root.capture-active-window(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        DarkField {
                            horizontal-stretch: 2;
                            label: "Título contém (opcional, use |)";
                            placeholder: "ex: YouTube|Twitch|Netflix";
                            value <=> root.field-window-title;
                        }

                        DarkField {
                            horizontal-stretch: 1;
                            label: "Herdar de (opcional)";
                            placeholder: "ex: global";
                            value <=> root.field-inherits;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "Prioridade:";
                                color: #a1a1aa;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            DarkButton {
                                width: 28px;
                                height: 26px;
                                text: "-";
                                clicked => { root.change-priority(-5); }
                            }
                            Text {
                                width: 30px;
                                text: root.field-priority;
                                color: #f5f5f7;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            DarkButton {
                                width: 28px;
                                height: 26px;
                                text: "+";
                                clicked => { root.change-priority(5); }
                            }
                        }

                        DarkButton {
                            height: 26px;
                            primary: root.field-fullscreen-only;
                            text: root.field-fullscreen-only ? "Tela cheia: SIM" : "Tela cheia: Qualquer";
                            clicked => { root.toggle-fullscreen-only(); }
                        }

                        if root.captured-window-hint != "": Text {
                            horizontal-stretch: 1;
                            text: root.captured-window-hint;
                            color: #93c5fd;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    ActionRow {
                        control-label: "RotateCw (Horário)";
                        action-summary: root.summary-rotate-cw;
                        edit-clicked => { root.open-action-editor(0); }
                    }

                    ActionRow {
                        control-label: "RotateCcw (Anti-horário)";
                        action-summary: root.summary-rotate-ccw;
                        edit-clicked => { root.open-action-editor(1); }
                    }

                    ActionRow {
                        control-label: "Key1 (Esquerda)";
                        action-summary: root.summary-key1;
                        edit-clicked => { root.open-action-editor(2); }
                    }

                    ActionRow {
                        control-label: "Key2 (Meio)";
                        action-summary: root.summary-key2;
                        edit-clicked => { root.open-action-editor(3); }
                    }

                    ActionRow {
                        control-label: "Key3 (Direita)";
                        action-summary: root.summary-key3;
                        edit-clicked => { root.open-action-editor(4); }
                    }

                    Text {
                        text: "Nota: o clique no knob (KnobPress) abre o Hub Interativo; ações 'Nenhuma' herdam do perfil pai.";
                        color: rgba(255, 255, 255, 0.48);
                        font-size: 11px;
                    }
                }
            }
        }

        // ==================== ABA 1: OVERLAY / HUB ====================
        if root.active-tab == 1: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            // Coluna esquerda: itens do Hub
            Rectangle {
                width: 240px;
                border-radius: 10px;
                background: rgba(30, 30, 30, 0.9);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.1);

                VerticalLayout {
                    padding: 12px;
                    spacing: 7px;

                    Text {
                        text: "Itens do Hub";
                        color: #f5f5f7;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.hub-item-labels.length * 38px;

                        VerticalLayout {
                            spacing: 5px;
                            alignment: start;

                            for label[idx] in root.hub-item-labels: Rectangle {
                                height: 33px;
                                border-radius: 7px;
                                background: idx == root.hub-selected-index
                                    ? rgba(255, 255, 255, 0.18)
                                    : (hub-touch.has-hover ? rgba(255, 255, 255, 0.08) : rgba(255, 255, 255, 0.03));
                                border-width: 1px;
                                border-color: idx == root.hub-selected-index
                                    ? rgba(255, 255, 255, 0.35)
                                    : rgba(255, 255, 255, 0.06);

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: label;
                                        color: idx == root.hub-selected-index ? #ffffff : #d4d4d8;
                                        font-size: 12px;
                                        font-weight: idx == root.hub-selected-index ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                hub-touch := TouchArea {
                                    clicked => { root.hub-select-item(idx); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        DarkButton {
                            horizontal-stretch: 1;
                            text: "↑ Subir";
                            clicked => { root.hub-move-item(-1); }
                        }
                        DarkButton {
                            horizontal-stretch: 1;
                            text: "↓ Descer";
                            clicked => { root.hub-move-item(1); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        DarkButton {
                            horizontal-stretch: 1;
                            text: "+ Ação";
                            clicked => { root.hub-add-quick-action(); }
                        }
                        DarkButton {
                            horizontal-stretch: 1;
                            text: "+ Slider";
                            clicked => { root.hub-add-custom-slider(); }
                        }
                        DarkButton {
                            horizontal-stretch: 1;
                            text: "+ Grupo";
                            clicked => { root.hub-add-custom-group(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        DarkButton {
                            horizontal-stretch: 1;
                            text: "Padrão";
                            clicked => { root.hub-reset-defaults(); }
                        }
                        DarkButton {
                            horizontal-stretch: 1;
                            danger: true;
                            text: "Remover";
                            clicked => { root.hub-remove-item(); }
                        }
                    }
                }
            }

            // Coluna direita: ajustes gerais + editor do item selecionado
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 10px;
                background: rgba(30, 30, 30, 0.9);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.1);

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // Ajustes gerais do Hub
                    Rectangle {
                        border-radius: 8px;
                        background: rgba(18, 18, 20, 0.85);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.08);

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            Text {
                                text: "Comportamento do Hub";
                                color: #f5f5f7;
                                font-size: 13px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "Vol passo:"; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "-"; clicked => { root.hub-change-volume-step(-1); } }
                                    Text { width: 32px; text: root.hub-volume-step + "%"; color: #f5f5f7; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "+"; clicked => { root.hub-change-volume-step(1); } }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "Brilho passo:"; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "-"; clicked => { root.hub-change-brightness-step(-1); } }
                                    Text { width: 32px; text: root.hub-brightness-step + "%"; color: #f5f5f7; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "+"; clicked => { root.hub-change-brightness-step(1); } }
                                }

                                DarkButton {
                                    height: 24px;
                                    primary: root.hub-key3-is-confirm;
                                    text: root.hub-key3-is-confirm ? "K3: Confirmar" : "K3: Fechar";
                                    clicked => { root.hub-toggle-key3-behavior(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "Timeout navegar:"; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "-"; clicked => { root.hub-change-browse-timeout(-1); } }
                                    Text { width: 28px; text: root.hub-browse-timeout-sec + "s"; color: #f5f5f7; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "+"; clicked => { root.hub-change-browse-timeout(1); } }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: "Timeout ajustando:"; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "-"; clicked => { root.hub-change-adjust-timeout(-1); } }
                                    Text { width: 32px; text: root.hub-adjust-timeout-sec + "s"; color: #f5f5f7; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    DarkButton { width: 26px; height: 24px; text: "+"; clicked => { root.hub-change-adjust-timeout(1); } }
                                }

                                DarkButton {
                                    height: 24px;
                                    primary: root.hub-show-images;
                                    text: root.hub-show-images ? "Imagens: SIM" : "Imagens: NÃO";
                                    clicked => { root.hub-toggle-show-images(); }
                                }

                                DarkButton {
                                    height: 24px;
                                    primary: root.hub-animations-enabled;
                                    text: root.hub-animations-enabled ? "Animações: SIM" : "Animações: NÃO";
                                    clicked => { root.hub-toggle-animations(); }
                                }
                            }
                        }
                    }

                    // Editor do item selecionado
                    HorizontalLayout {
                        spacing: 10px;
                        DarkField {
                            horizontal-stretch: 1;
                            label: "Título do item (" + root.hub-item-kind-label + ")";
                            placeholder: "ex: Sons & Apps";
                            value <=> root.hub-item-title;
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Estado"; color: #a1a1aa; font-size: 11px; }
                            DarkButton {
                                width: 110px;
                                height: 32px;
                                primary: root.hub-item-enabled;
                                text: root.hub-item-enabled ? "Ativo no Hub" : "Oculto";
                                clicked => { root.hub-toggle-enabled(); }
                            }
                        }
                    }

                    // Imagem opcional do item selecionado
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Imagem opcional:";
                            color: #a1a1aa;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.hub-item-icon-label;
                            color: #d4d4d8;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        DarkButton {
                            height: 24px;
                            text: "Escolher...";
                            clicked => { root.hub-pick-item-icon(); }
                        }
                        DarkButton {
                            height: 24px;
                            text: "Limpar";
                            clicked => { root.hub-clear-item-icon(); }
                        }
                    }

                    // Modo 0: Módulo nativo embutido
                    if root.hub-item-editor-mode == 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: rgba(18, 18, 20, 0.65);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.06);

                        VerticalLayout {
                            padding: 14px;
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "Módulo nativo: " + root.hub-item-kind-label;
                                color: #f5f5f7;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Você pode renomear, reordenar ou ocultar este módulo no Hub.";
                                color: #a1a1aa;
                                font-size: 11px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Modo 1: Ação Rápida
                    if root.hub-item-editor-mode == 1: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;
                        ActionRow {
                            control-label: "Ação ao confirmar";
                            action-summary: root.hub-quick-action-summary;
                            edit-clicked => { root.hub-edit-quick-action(); }
                        }
                    }

                    // Modo 2: Slider Customizado
                    if root.hub-item-editor-mode == 2: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;

                        DarkField {
                            label: "Comando ao girar horário (+)";
                            placeholder: "ex: hyprctl keyword cursor:zoom_factor 2";
                            value <=> root.hub-slider-up;
                        }
                        DarkField {
                            label: "Comando ao girar anti-horário (-)";
                            placeholder: "ex: hyprctl keyword cursor:zoom_factor 1";
                            value <=> root.hub-slider-down;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            DarkField {
                                horizontal-stretch: 1;
                                label: "Comando K2 (opcional)";
                                placeholder: "ex: toggle / reset";
                                value <=> root.hub-slider-toggle;
                            }
                            DarkField {
                                horizontal-stretch: 1;
                                label: "Comando leitura 0-100 (opcional)";
                                placeholder: "ex: echo 50";
                                value <=> root.hub-slider-read;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { text: "Passo visual:"; color: #a1a1aa; font-size: 11px; vertical-alignment: center; }
                            DarkButton { width: 26px; height: 24px; text: "-"; clicked => { root.hub-change-slider-step(-1); } }
                            Text { width: 32px; text: root.hub-slider-step + "%"; color: #f5f5f7; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            DarkButton { width: 26px; height: 24px; text: "+"; clicked => { root.hub-change-slider-step(1); } }
                        }
                    }

                    // Modo 3: Submenu Customizado (Grupo de Ações)
                    if root.hub-item-editor-mode == 3: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Entradas do submenu:";
                                color: #d4d4d8;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            DarkButton {
                                height: 25px;
                                text: "+ Entrada";
                                clicked => { root.hub-group-add-entry(); }
                            }
                            DarkButton {
                                height: 25px;
                                danger: true;
                                text: "Remover";
                                clicked => { root.hub-group-remove-entry(); }
                            }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-height: root.hub-group-entry-labels.length * 34px;

                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                for elabel[eidx] in root.hub-group-entry-labels: Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: eidx == root.hub-group-selected-entry
                                        ? rgba(59, 130, 246, 0.25)
                                        : rgba(255, 255, 255, 0.04);
                                    border-width: 1px;
                                    border-color: eidx == root.hub-group-selected-entry
                                        ? rgba(96, 165, 250, 0.6)
                                        : rgba(255, 255, 255, 0.06);

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: elabel;
                                            color: #f5f5f7;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.hub-group-select-entry(eidx); }
                                    }
                                }
                            }
                        }

                        if root.hub-group-entry-labels.length > 0: VerticalLayout {
                            spacing: 6px;
                            DarkField {
                                label: "Nome da entrada selecionada";
                                placeholder: "ex: Abrir Obsidian";
                                value <=> root.hub-group-entry-name;
                            }
                            ActionRow {
                                control-label: "Ação da entrada";
                                action-summary: root.hub-group-entry-action-summary;
                                edit-clicked => { root.hub-group-edit-entry-action(); }
                            }
                        }
                    }
                }
            }
        }

        // Mensagem de erro global
        if root.error-message != "": Rectangle {
            border-radius: 6px;
            background: rgba(220, 38, 38, 0.22);
            border-width: 1px;
            border-color: rgba(248, 113, 113, 0.45);

            HorizontalLayout {
                padding: 8px;
                Text {
                    text: root.error-message;
                    color: #fca5a5;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        // Rodapé global: Cancelar / Salvar
        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            DarkButton {
                text: "Cancelar";
                clicked => { root.cancel-requested(); }
            }

            DarkButton {
                text: "Salvar";
                primary: true;
                clicked => { root.save-requested(); }
            }
        }
    }

    if root.preset-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.62);

        TouchArea {
            clicked => { root.toggle-preset-picker(); }
        }

        Rectangle {
            width: 420px;
            height: 360px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: rgba(24, 24, 27, 0.98);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.16);

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: "Adicionar Preset Contextual";
                    color: #f5f5f7;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: "Escolha um comportamento pronto para adicionar aos seus perfis:";
                    color: #a1a1aa;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    for label[idx] in root.preset-labels: DarkButton {
                        height: 34px;
                        text: label;
                        clicked => { root.add-preset(idx); }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    DarkButton {
                        text: "Fechar";
                        clicked => { root.toggle-preset-picker(); }
                    }
                }
            }
        }
    }

    if root.editor-open: ActionEditorPopover {
        width: 100%;
        height: 100%;
        control-title: root.editor-control-title;
        type-titles: root.editor-type-titles;
        selected-type-index: root.editor-type-index;
        shortcut-text <=> root.editor-shortcut-text;
        capturing-shortcut: root.editor-capturing-shortcut;
        selected-media-index: root.editor-media-index;
        app-search <=> root.editor-app-search;
        filtered-app-names: root.editor-filtered-apps;
        selected-app-index: root.editor-selected-app-index;
        url-text <=> root.editor-url-text;
        file-text <=> root.editor-file-text;
        exec-text <=> root.editor-exec-text;
        scroll-direction-index: root.editor-scroll-direction;
        scroll-amount: root.editor-scroll-amount;
        macro-step-labels: root.editor-macro-steps;
        macro-key-text <=> root.editor-macro-key-text;
        macro-wait-text <=> root.editor-macro-wait-text;
        capturing-macro-key: root.editor-capturing-macro;
        error-message: root.editor-error-message;

        select-type(i) => { root.editor-select-type(i); }
        toggle-shortcut-capture => { root.editor-toggle-shortcut-capture(); }
        shortcut-key-captured(t, c, a, s, m) => { root.editor-shortcut-key-captured(t, c, a, s, m); }
        select-media(i) => { root.editor-select-media(i); }
        app-search-changed(q) => { root.editor-app-search-changed(q); }
        select-app(i) => { root.editor-select-app(i); }
        pick-file => { root.editor-pick-file(); }
        select-scroll-direction(i) => { root.editor-select-scroll-direction(i); }
        change-scroll-amount(d) => { root.editor-change-scroll-amount(d); }
        toggle-macro-capture => { root.editor-toggle-macro-capture(); }
        macro-key-captured(t, c, a, s, m) => { root.editor-macro-key-captured(t, c, a, s, m); }
        add-macro-key => { root.editor-add-macro-key(); }
        add-macro-wait => { root.editor-add-macro-wait(); }
        remove-macro-step(i) => { root.editor-remove-macro-step(i); }
        save-action => { root.editor-save(); }
        cancel-action => { root.editor-cancel(); }
    }
}
