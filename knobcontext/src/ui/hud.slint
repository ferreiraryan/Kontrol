export component MiniHud inherits Window {
    title: "KnobContext HUD";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 224px;
    height: 52px;

    in property <string> glyph: "♫";
    in property <string> label: "Volume";
    in property <string> value-text: "50%";
    in property <bool> has-progress: true;
    in property <int> value-percent: 50;
    in property <int> max-percent: 100;
    in property <bool> is-muted: false;
    in property <bool> has-art: false;
    in property <image> art-source;
    in property <bool> use-backdrop-blur: false;
    in property <bool> animations-enabled: true;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        clip: true;
        background: rgba(12, 14, 18, 0.64);
        border-width: 1px;
        border-color: root.is-muted
            ? rgba(248, 113, 113, 0.55)
            : rgba(255, 255, 255, 0.14);

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            alignment: stretch;

            // Só mostra thumbnail quando houver capa real; sem imagem fica apenas o texto minimalista
            if root.has-art: Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 6px;
                clip: true;
                background: rgba(10, 12, 16, 0.8);

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.art-source;
                    image-fit: cover;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: stretch;

                    Text {
                        horizontal-stretch: 1;
                        text: root.label;
                        color: rgba(244, 246, 250, 0.94);
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.value-text != "": Text {
                        text: root.value-text;
                        color: root.is-muted ? #fca5a5 : rgba(203, 213, 225, 0.88);
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                if root.has-progress: Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: rgba(255, 255, 255, 0.16);
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: 100%;
                        width: parent.width * max(0.0, min(1.0, root.value-percent / max(1, root.max-percent)));
                        border-radius: 1.5px;
                        background: root.is-muted ? #ef4444 : #93c5fd;

                        animate width {
                            duration: root.animations-enabled ? 80ms : 0ms;
                            easing: ease-out;
                        }
                    }
                }
            }
        }
    }
}
