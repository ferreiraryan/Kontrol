export component MiniHud inherits Window {
    title: "KnobContext HUD";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 244px;
    height: 68px;

    in property <string> glyph: "♫";
    in property <string> label: "Volume";
    in property <string> value-text: "50%";
    in property <bool> has-progress: true;
    in property <int> value-percent: 50;
    in property <int> max-percent: 100;
    in property <bool> is-muted: false;
    in property <bool> has-art: false;
    in property <image> art-source;
    in property <bool> use-backdrop-blur: false;
    in property <bool> animations-enabled: true;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        clip: true;
        backdrop-blur: root.use-backdrop-blur ? 14px : 0px;
        background: root.use-backdrop-blur
            ? rgba(20, 20, 20, 0.72)
            : @linear-gradient(180deg, rgba(28, 30, 36, 0.88) 0%, rgba(16, 17, 22, 0.86) 100%);
        border-width: 1px;
        border-color: root.is-muted
            ? rgba(248, 113, 113, 0.55)
            : rgba(255, 255, 255, 0.08);

        // Sombra interna sutil simulando profundidade glassmorphism no renderer software
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 11px;
            background: transparent;
            border-width: 1px;
            border-color: rgba(0, 0, 0, 0.40);
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 10px;
            alignment: stretch;

            // Badge de capa SMTC ou ícone compacto à esquerda
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                clip: true;
                background: root.has-art
                    ? rgba(10, 12, 16, 0.9)
                    : (root.is-muted
                        ? rgba(239, 68, 68, 0.20)
                        : rgba(96, 165, 250, 0.18));
                border-width: 1px;
                border-color: root.is-muted
                    ? rgba(248, 113, 113, 0.42)
                    : rgba(147, 197, 253, 0.28);

                if root.has-art: Image {
                    width: 100%;
                    height: 100%;
                    source: root.art-source;
                    image-fit: cover;
                }

                if !root.has-art: Text {
                    text: root.glyph;
                    color: root.is-muted ? #fca5a5 : rgba(240, 240, 240, 0.95);
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Conteúdo: título + valor + barra fina opcional (contraste WCAG AA)
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 5px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: stretch;

                    Text {
                        horizontal-stretch: 1;
                        text: root.label;
                        color: rgba(240, 240, 240, 0.95);
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.value-text != "": Text {
                        text: root.value-text;
                        color: root.is-muted ? #fca5a5 : rgba(200, 200, 200, 0.88);
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                if root.has-progress: Rectangle {
                    height: 5px;
                    border-radius: 3px;
                    background: rgba(255, 255, 255, 0.14);
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: 100%;
                        width: parent.width * max(0.0, min(1.0, root.value-percent / max(1, root.max-percent)));
                        border-radius: 3px;
                        background: root.is-muted ? #ef4444 : #60a5fa;

                        animate width {
                            duration: root.animations-enabled ? 90ms : 0ms;
                            easing: ease-out;
                        }
                    }
                }
            }
        }
    }
}
