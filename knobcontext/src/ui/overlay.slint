export struct OverlayCardData {
    is-empty: bool,
    title: string,
    subtitle: string,
    badge: string,
    glyph: string,
    has-image: bool,
    image-is-cover: bool,
    image-source: image,
    value-percent: int,
    max-percent: int,
    is-slider: bool,
    is-active: bool,
    is-muted: bool,
    is-playing: bool,
}

component CarouselCard inherits Rectangle {
    in property <OverlayCardData> card;
    /// Distância assinada em slots em relação ao centro (`0.0` = centro, `-1.0` = esquerda, `+1.0` = direita).
    in property <float> slot-pos: 0.0;
    in property <bool> adjusting: false;
    in property <bool> animations-enabled: true;
    /// Pulso tátil visual (`0.0..1.0`): aplica escala 0.98× no card focado ao pressionar o knob.
    in property <float> press-pulse: 0.0;

    private property <float> dist: abs(root.slot-pos);
    private property <float> center-weight: max(0.0, 1.0 - root.dist);
    private property <float> outer: max(0.0, min(1.0, root.dist - 1.0));
    private property <float> edge-fade: max(0.0, min(1.0, (2.85 - root.dist) / 0.75));
    private property <bool> is-center-dominant: root.center-weight > 0.55;
    private property <float> press-scale: 1.0 - 0.02 * root.press-pulse * root.center-weight;

    width: (160px + 64px * root.center-weight - 16px * root.outer) * root.press-scale;
    height: (140px + 28px * root.center-weight - 12px * root.outer) * root.press-scale;
    border-radius: 11px + 3px * root.center-weight;
    background: root.card.is-empty
        ? transparent
        : (root.adjusting
            ? rgba(37, 99, 235, 0.24 * root.center-weight)
            : rgba(255, 255, 255, 0.08 * root.center-weight));
    border-width: root.card.is-empty ? 0px : (1.2px * root.center-weight);
    border-color: root.adjusting
        ? rgba(96, 165, 250, 0.88 * root.center-weight)
        : rgba(255, 255, 255, 0.16 * root.center-weight);

    if !root.card.is-empty && root.edge-fade > 0.02: VerticalLayout {
        padding-top: 6px + 4px * root.center-weight;
        padding-bottom: 4px + 4px * root.center-weight;
        padding-left: 4px + 6px * root.center-weight;
        padding-right: 4px + 6px * root.center-weight;
        spacing: 5px + 2px * root.center-weight;
        alignment: center;

        // Área visual principal do card (16:10 thumbnail, capa de álbum, ícone de app ou card limpo)
        Rectangle {
            height: 92px + 22px * root.center-weight - 10px * root.outer;
            border-radius: 10px;
            clip: true;
            background: root.card.has-image && root.card.image-is-cover
                ? rgba(10, 12, 16, 0.9 * root.edge-fade)
                : (root.is-center-dominant && root.adjusting
                    ? rgba(30, 58, 138, 0.58)
                    : rgba(26 + 8 * root.center-weight, 29 + 9 * root.center-weight, 39 + 11 * root.center-weight, (0.78 + 0.14 * root.center-weight) * root.edge-fade));
            border-width: 1px;
            border-color: root.is-center-dominant && root.adjusting
                ? rgba(96, 165, 250, 0.85)
                : (root.card.is-active
                    ? rgba(147, 197, 253, (0.34 + 0.25 * root.center-weight) * root.edge-fade)
                    : rgba(255, 255, 255, (0.08 + 0.16 * root.center-weight) * root.edge-fade));

            // 1. Imagem Cover (ex.: Capa de álbum SMTC, Wallpapers ou imagem customizada)
            if root.card.has-image && root.card.image-is-cover: Image {
                width: 100%;
                height: 100%;
                source: root.card.image-source;
                image-fit: cover;
                opacity: (0.68 + 0.32 * root.center-weight - 0.14 * root.outer) * root.edge-fade;
            }

            // Sobreposição discreta de subtítulo quando Cover não é slider (ex.: artista SMTC)
            if root.card.has-image && root.card.image-is-cover && !root.card.is-slider && root.card.subtitle != "": Rectangle {
                x: 0px;
                y: parent.height - 22px;
                width: 100%;
                height: 22px;
                background: rgba(10, 12, 18, 0.78 * root.edge-fade);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    Text {
                        text: root.card.subtitle;
                        color: rgba(240, 240, 240, 0.92 * root.edge-fade);
                        font-size: 10px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // Sobreposição discreta de progresso quando um Slider possui imagem Cover
            if root.card.has-image && root.card.image-is-cover && root.card.is-slider: Rectangle {
                x: 0px;
                y: parent.height - 26px;
                width: 100%;
                height: 26px;
                background: rgba(10, 12, 18, 0.80 * root.edge-fade);

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 3px;
                    padding-bottom: 4px;
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: root.card.badge;
                        color: root.card.is-muted ? #fca5a5 : rgba(240, 240, 240, 0.95);
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: rgba(255, 255, 255, 0.18);
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            height: 100%;
                            width: parent.width * max(0.0, min(1.0, root.card.value-percent / max(1, root.card.max-percent)));
                            border-radius: 2px;
                            background: root.card.is-muted
                                ? #ef4444
                                : (root.is-center-dominant && root.adjusting ? #3b82f6 : #93c5fd);

                            animate width {
                                duration: root.animations-enabled ? 110ms : 0ms;
                                easing: ease-out;
                            }
                        }
                    }
                }
            }

            // 2. Ícone de aplicativo (ex.: Firefox no Mixer ou LaunchApp)
            if root.card.has-image && !root.card.image-is-cover: VerticalLayout {
                alignment: center;
                padding: 8px;
                spacing: 5px;

                HorizontalLayout {
                    alignment: center;
                    Image {
                        width: (root.card.is-slider ? 36px + 10px * root.center-weight : 40px + 18px * root.center-weight);
                        height: (root.card.is-slider ? 36px + 10px * root.center-weight : 40px + 18px * root.center-weight);
                        source: root.card.image-source;
                        image-fit: contain;
                        opacity: (0.72 + 0.28 * root.center-weight - 0.12 * root.outer) * root.edge-fade;
                    }
                }

                if root.card.is-slider: VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: root.card.badge;
                        color: root.card.is-muted ? #fca5a5 : rgba(240, 240, 240, 0.95);
                        font-size: root.is-center-dominant ? 13px : 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 5px;
                        border-radius: 3px;
                        background: rgba(255, 255, 255, 0.14);
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            height: 100%;
                            width: parent.width * max(0.0, min(1.0, root.card.value-percent / max(1, root.card.max-percent)));
                            border-radius: 3px;
                            background: root.card.is-muted
                                ? #ef4444
                                : (root.is-center-dominant && root.adjusting ? #3b82f6 : #93c5fd);

                            animate width {
                                duration: root.animations-enabled ? 110ms : 0ms;
                                easing: ease-out;
                            }
                        }
                    }
                }
            }

            // 3. Card minimalista SEM imagem (Sliders, Workspaces, Saídas, Brilho, Mídia sem capa)
            if !root.card.has-image: VerticalLayout {
                alignment: center;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                if root.card.is-slider: Text {
                    text: root.card.is-muted ? "MUTE" : (root.card.value-percent + "%");
                    color: root.card.is-muted
                        ? #fca5a5
                        : rgba(240, 240, 240, (0.78 + 0.17 * root.center-weight) * root.edge-fade);
                    font-size: root.is-center-dominant ? 24px : 17px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                if !root.card.is-slider: Text {
                    text: root.card.glyph;
                    color: rgba(240, 240, 240, (0.68 + 0.27 * root.center-weight - 0.12 * root.outer) * root.edge-fade);
                    font-size: root.is-center-dominant ? 30px : 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                if root.card.is-slider: Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: rgba(255, 255, 255, 0.14);
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: 100%;
                        width: parent.width * max(0.0, min(1.0, root.card.value-percent / max(1, root.card.max-percent)));
                        border-radius: 3px;
                        background: root.card.is-muted
                            ? #ef4444
                            : (root.is-center-dominant && root.adjusting ? #3b82f6 : #93c5fd);

                        animate width {
                            duration: root.animations-enabled ? 110ms : 0ms;
                            easing: ease-out;
                        }
                    }
                }

                if !root.card.is-slider && root.card.subtitle != "": Text {
                    text: root.card.subtitle;
                    color: rgba(200, 200, 200, (0.76 + 0.09 * root.center-weight) * root.edge-fade);
                    font-size: 10px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            // Indicador animado de "tocando" (GIF equalizer nativo Slint 1.19 + fallback estático em Reduced Motion)
            if root.card.is-playing: Rectangle {
                x: 6px;
                y: 6px;
                width: 24px;
                height: 20px;
                border-radius: 6px;
                background: rgba(15, 23, 42, 0.84 * root.edge-fade);
                border-width: 1px;
                border-color: rgba(96, 165, 250, 0.55 * root.edge-fade);

                if root.animations-enabled: Image {
                    width: 15px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../assets/playing-eq.gif");
                    image-fit: contain;
                }

                if !root.animations-enabled: Text {
                    text: "♪";
                    color: #93c5fd;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Badge discreto no canto superior direito (ATUAL / ATIVO / TOCANDO / ON / OFF)
            if root.card.badge != "" && !root.card.is-slider: Rectangle {
                x: parent.width - self.width - 6px;
                y: 6px;
                min-width: 48px;
                height: 18px;
                border-radius: 9px;
                background: root.card.is-active
                    ? rgba(37, 99, 235, 0.88 * root.edge-fade)
                    : rgba(15, 23, 42, 0.82 * root.edge-fade);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.18 * root.edge-fade);

                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    alignment: center;
                    Text {
                        text: root.card.badge;
                        color: rgba(240, 240, 240, 0.95 * root.edge-fade);
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Título centralizado abaixo do card (contraste WCAG AA)
        Text {
            text: root.card.title;
            color: rgba(240, 240, 240, (0.76 + 0.19 * root.center-weight - 0.10 * root.outer) * root.edge-fade);
            font-size: root.is-center-dominant ? 12px : 11px;
            font-weight: root.is-center-dominant ? 700 : 500;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component Overlay inherits Window {
    title: "KnobContext Overlay";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 960px;
    height: 256px;

    in property <string> parent-pill: "Auto • global";
    in property <string> active-pill: "KnobContext";
    in property <string> status-pill: "1 / 7";
    in property <bool> adjusting: false;
    in property <bool> loading: false;
    in property <string> empty-message: "";
    in property <[OverlayCardData]> cards: [];
    in property <string> footer-hint: "Girar: Navegar • Knob/K3: Abrir • K1: Fechar";

    // Configurações de renderização e acessibilidade
    in property <bool> use-backdrop-blur: false;
    in property <bool> animations-enabled: true;

    // Propriedades animadas a 60fps pelo CarouselAnimator (0% CPU em repouso)
    in property <float> scroll-phase: 0.0;
    in property <float> open-progress: 1.0;
    in property <float> screen-progress: 1.0;
    in property <float> press-pulse: 0.0;
    in property <float> spinner-phase: 0.0;

    /// Garante que o foco central do carrossel esteja visível com scroll suave (ou instantâneo em Reduced Motion).
    public function ensure-focused-visible() {
        focused-anchor.ensure-visible(
            root.animations-enabled ? ScrollBehavior.smooth : ScrollBehavior.instant
        );
    }

    Rectangle {
        x: 0px;
        y: (1.0 - root.open-progress) * 12px;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        clip: true;
        // FemtoVG usa `backdrop-blur` real; Software simula glassmorphism com gradiente + transparência + sombra interna.
        backdrop-blur: root.use-backdrop-blur ? 14px : 0px;
        background: root.use-backdrop-blur
            ? rgba(20, 20, 20, 0.72 * root.open-progress)
            : @linear-gradient(180deg, rgba(28, 30, 36, 0.86 * root.open-progress) 0%, rgba(16, 17, 22, 0.84 * root.open-progress) 100%);
        border-width: 1.5px;
        border-color: root.adjusting
            ? rgba(96, 165, 250, 0.85 * root.open-progress)
            : rgba(255, 255, 255, 0.08 * root.open-progress);

        animate border-color {
            duration: root.animations-enabled ? 140ms : 0ms;
            easing: ease-out;
        }

        // Sombra interna sutil (rgba(0, 0, 0, 0.4)) para profundidade glassmorphism
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: parent.width - 3px;
            height: parent.height - 3px;
            border-radius: 18.5px;
            background: transparent;
            border-width: 1px;
            border-color: rgba(0, 0, 0, 0.40 * root.open-progress);
        }

        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 10px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 6px;
            alignment: stretch;

            // Barra superior centralizada com pílulas estilo Caelestia
            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Rectangle {
                    height: 26px;
                    border-radius: 13px;
                    background: rgba(255, 255, 255, 0.06);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        Text {
                            text: root.parent-pill;
                            color: rgba(200, 200, 200, 0.85);
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }

                // Pílula central em destaque
                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: root.adjusting ? #3b82f6 : #c7d2fe;

                    animate background {
                        duration: root.animations-enabled ? 140ms : 0ms;
                        easing: ease-out;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;
                        Text {
                            text: root.active-pill;
                            color: root.adjusting ? #ffffff : #0f172a;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 26px;
                    border-radius: 13px;
                    background: root.adjusting
                        ? rgba(59, 130, 246, 0.25)
                        : rgba(255, 255, 255, 0.06);
                    border-width: root.adjusting ? 1px : 0px;
                    border-color: rgba(96, 165, 250, 0.65);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;

                        // Indicador sutil de carregamento na barra quando o SystemWorker está buscando dados
                        if root.loading: Rectangle {
                            width: 7px;
                            height: 7px;
                            y: 9px;
                            border-radius: 3.5px;
                            background: rgba(96, 165, 250, 0.45 + 0.55 * abs(sin(root.spinner-phase * 360deg)));
                        }

                        Text {
                            text: root.status-pill;
                            color: root.adjusting ? #bfdbfe : rgba(200, 200, 200, 0.85);
                            font-size: 11px;
                            font-weight: root.adjusting ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Carrossel contínuo de 7 slots com clip suave, fade de 120ms entre telas e ensure-visible()
            carousel-stage := Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: self.height;
                interactive: false;

                focused-anchor := Rectangle {
                    x: parent.width / 2 - 1px;
                    y: parent.height / 2 - 1px;
                    width: 2px;
                    height: 2px;
                    background: transparent;
                }

                if root.loading && root.cards.length == 0: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: 10px;

                    // Spinner sutil de 3 pontos pulsantes
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: rgba(96, 165, 250, 0.35 + 0.65 * abs(sin(root.spinner-phase * 360deg)));
                        }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: rgba(96, 165, 250, 0.35 + 0.65 * abs(sin((root.spinner-phase + 0.33) * 360deg)));
                        }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: rgba(96, 165, 250, 0.35 + 0.65 * abs(sin((root.spinner-phase + 0.66) * 360deg)));
                        }
                    }

                    Text {
                        text: "Carregando...";
                        color: rgba(200, 200, 200, 0.85);
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }

                if !root.loading && root.cards.length == 0: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    opacity: root.screen-progress;
                    Text {
                        text: root.empty-message;
                        color: rgba(200, 200, 200, 0.85);
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }

                if root.cards.length > 0: Rectangle {
                    x: 0px;
                    y: (1.0 - root.screen-progress) * 8px;
                    width: parent.width;
                    height: parent.height;
                    background: transparent;
                    opacity: root.screen-progress;

                    for card[idx] in root.cards: CarouselCard {
                        property <float> pos: (idx - 3) + root.scroll-phase;
                        property <length> dx: 164px * pos + 40px * max(-1.0, min(1.0, pos));
                        card: card;
                        slot-pos: pos;
                        adjusting: root.adjusting;
                        animations-enabled: root.animations-enabled;
                        press-pulse: root.press-pulse;
                        x: parent.width / 2 + dx - self.width / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Rodapé discreto centralizado (contraste WCAG AA)
            Text {
                text: root.footer-hint;
                color: rgba(200, 200, 200, 0.85);
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}
