export struct OverlayCardData {
    is-empty: bool,
    title: string,
    subtitle: string,
    badge: string,
    glyph: string,
    has-image: bool,
    image-is-cover: bool,
    image-source: image,
    value-percent: int,
    max-percent: int,
    is-slider: bool,
    is-active: bool,
    is-muted: bool,
    is-playing: bool,
}

component CarouselCard inherits Rectangle {
    in property <OverlayCardData> card;
    /// Distância assinada em slots em relação ao centro (`0.0` = centro, `-1.0` = esquerda, `+1.0` = direita).
    in property <float> slot-pos: 0.0;
    in property <bool> adjusting: false;
    in property <bool> animations-enabled: true;
    in property <float> press-pulse: 0.0;

    private property <float> dist: abs(root.slot-pos);
    private property <float> center-weight: max(0.0, 1.0 - root.dist);
    private property <float> outer: max(0.0, min(1.0, root.dist - 1.0));
    private property <float> edge-fade: max(0.0, min(1.0, (2.75 - root.dist) / 0.75));
    private property <bool> is-center-dominant: root.center-weight > 0.55;

    /// Fator suave de expansão vertical/horizontal quando o card possui imagem (`0.0` = só texto embaixo, `1.0` = imagem expandida).
    private property <float> image-expand: root.card.has-image ? 1.0 : 0.0;
    animate image-expand {
        duration: root.animations-enabled ? 180ms : 0ms;
        easing: ease-out;
    }

    private property <length> image-box-height: root.card.image-is-cover
        ? (54px + 66px * root.center-weight) * root.image-expand
        : (36px + 32px * root.center-weight) * root.image-expand;
    private property <length> image-gap: 6px * root.image-expand;
    private property <length> label-pill-height: (!root.card.has-image && root.card.is-slider) ? 38px : 28px;

    width: 112px + 28px * root.center-weight - 8px * root.outer + (16px + 24px * root.center-weight) * root.image-expand;
    height: root.card.is-empty ? 0px : (root.image-box-height + root.image-gap + root.label-pill-height);
    background: transparent;

    if !root.card.is-empty && root.edge-fade > 0.02: VerticalLayout {
        spacing: root.image-gap;
        alignment: end;

        // Área expansível de imagem (só aparece e expande quando o card possui imagem)
        if root.image-expand > 0.01: Rectangle {
            height: root.image-box-height;
            border-radius: 10px;
            clip: true;
            background: rgba(12, 14, 18, (0.58 + 0.16 * root.center-weight) * root.edge-fade * root.image-expand);
            border-width: 1px;
            border-color: root.is-center-dominant && root.adjusting
                ? rgba(96, 165, 250, 0.80 * root.image-expand)
                : rgba(255, 255, 255, (0.10 + 0.12 * root.center-weight) * root.edge-fade * root.image-expand);

            // 1. Imagem Cover (capa de álbum SMTC, wallpaper ou imagem customizada)
            if root.card.has-image && root.card.image-is-cover: Image {
                width: 100%;
                height: 100%;
                source: root.card.image-source;
                image-fit: cover;
                opacity: (0.76 + 0.24 * root.center-weight - 0.12 * root.outer) * root.edge-fade * root.image-expand;
            }

            // 2. Ícone de aplicativo (contain)
            if root.card.has-image && !root.card.image-is-cover: Image {
                width: 28px + 20px * root.center-weight;
                height: 28px + 20px * root.center-weight;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.card.image-source;
                image-fit: contain;
                opacity: (0.78 + 0.22 * root.center-weight - 0.12 * root.outer) * root.edge-fade * root.image-expand;
            }

            // Barra fina de progresso na base da imagem quando for slider com imagem
            if root.card.is-slider: Rectangle {
                x: 0px;
                y: parent.height - 4px;
                width: 100%;
                height: 4px;
                background: rgba(0, 0, 0, 0.45);

                Rectangle {
                    x: 0px;
                    y: 0px;
                    height: 100%;
                    width: parent.width * max(0.0, min(1.0, root.card.value-percent / max(1, root.card.max-percent)));
                    background: root.card.is-muted
                        ? #ef4444
                        : (root.is-center-dominant && root.adjusting ? #60a5fa : #e2e8f0);

                    animate width {
                        duration: root.animations-enabled ? 90ms : 0ms;
                        easing: ease-out;
                    }
                }
            }

            // Ponto discreto indicando mídia em reprodução
            if root.card.is-playing: Rectangle {
                x: 7px;
                y: 7px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #60a5fa;
            }
        }

        // Base minimalista embaixo: apenas texto pequeno (e barra fina se for slider sem imagem)
        Rectangle {
            height: root.label-pill-height;
            border-radius: 8px;
            background: rgba(12, 14, 18, (0.42 + 0.34 * root.center-weight) * root.edge-fade);
            border-width: root.center-weight > 0.25 ? 1px : 0px;
            border-color: root.is-center-dominant && root.adjusting
                ? rgba(96, 165, 250, 0.85 * root.center-weight)
                : rgba(255, 255, 255, 0.24 * root.center-weight * root.edge-fade);

            VerticalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: (!root.card.has-image && root.card.is-slider) ? 5px : 0px;
                padding-bottom: (!root.card.has-image && root.card.is-slider) ? 5px : 0px;
                spacing: 4px;
                alignment: center;

                HorizontalLayout {
                    spacing: 5px;
                    alignment: center;

                    if root.card.is-active && !root.card.is-slider: Rectangle {
                        width: 5px;
                        height: 5px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2.5px;
                        background: #60a5fa;
                    }

                    Text {
                        text: root.card.title;
                        color: rgba(244, 246, 250, (0.68 + 0.30 * root.center-weight - 0.14 * root.outer) * root.edge-fade);
                        font-size: root.is-center-dominant ? 11.5px : 10.5px;
                        font-weight: root.is-center-dominant ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.card.is-slider: Text {
                        text: root.card.is-muted ? "MUTE" : (root.card.value-percent + "%");
                        color: root.card.is-muted
                            ? #fca5a5
                            : rgba(203, 213, 225, (0.72 + 0.24 * root.center-weight) * root.edge-fade);
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                if !root.card.has-image && root.card.is-slider: Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: rgba(255, 255, 255, 0.16);
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: 100%;
                        width: parent.width * max(0.0, min(1.0, root.card.value-percent / max(1, root.card.max-percent)));
                        border-radius: 1.5px;
                        background: root.card.is-muted
                            ? #ef4444
                            : (root.is-center-dominant && root.adjusting ? #60a5fa : #cbd5e1);

                        animate width {
                            duration: root.animations-enabled ? 90ms : 0ms;
                            easing: ease-out;
                        }
                    }
                }
            }
        }
    }
}

export component Overlay inherits Window {
    title: "KnobContext Overlay";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 960px;
    height: 224px;

    in property <string> parent-pill: "Auto • global";
    in property <string> active-pill: "KnobContext";
    in property <string> status-pill: "1 / 5";
    in property <bool> adjusting: false;
    in property <bool> loading: false;
    in property <string> empty-message: "";
    in property <[OverlayCardData]> cards: [];
    in property <string> footer-hint: "";

    // Propriedades preservadas para compatibilidade com OverlayWindow
    in property <bool> use-backdrop-blur: false;
    in property <bool> animations-enabled: true;

    // Propriedades animadas pelo CarouselAnimator (0% CPU em repouso)
    in property <float> scroll-phase: 0.0;
    in property <float> open-progress: 1.0;
    in property <float> screen-progress: 1.0;
    in property <float> press-pulse: 0.0;
    in property <float> spinner-phase: 0.0;

    public function ensure-focused-visible() {
        focused-anchor.ensure-visible(
            root.animations-enabled ? ScrollBehavior.smooth : ScrollBehavior.instant
        );
    }

    // Container 100% transparente ancorado na parte inferior da janela
    Rectangle {
        x: 0px;
        y: (1.0 - root.open-progress) * 8px;
        width: 100%;
        height: 100%;
        background: transparent;
        opacity: root.open-progress;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            spacing: 8px;
            alignment: end;

            // Palco do carrossel (transparente; cards ancorados na base expandem para cima quando há imagem)
            carousel-stage := Flickable {
                height: 168px;
                content-width: self.width;
                content-height: self.height;
                interactive: false;

                focused-anchor := Rectangle {
                    x: parent.width / 2 - 1px;
                    y: parent.height - 16px;
                    width: 2px;
                    height: 2px;
                    background: transparent;
                }

                if root.loading && root.cards.length == 0: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height;
                    width: 140px;
                    height: 28px;
                    border-radius: 8px;
                    background: rgba(12, 14, 18, 0.58);

                    Text {
                        text: "Carregando...";
                        color: rgba(226, 232, 240, 0.88);
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !root.loading && root.cards.length == 0 && root.empty-message != "": Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height;
                    width: 260px;
                    height: 28px;
                    border-radius: 8px;
                    background: rgba(12, 14, 18, 0.58);
                    opacity: root.screen-progress;

                    Text {
                        text: root.empty-message;
                        color: rgba(226, 232, 240, 0.85);
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if root.cards.length > 0: Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    background: transparent;
                    opacity: root.screen-progress;

                    for card[idx] in root.cards: CarouselCard {
                        property <float> pos: (idx - 3) + root.scroll-phase;
                        property <length> dx: 140px * pos + 26px * max(-1.0, min(1.0, pos));
                        card: card;
                        slot-pos: pos;
                        adjusting: root.adjusting;
                        animations-enabled: root.animations-enabled;
                        press-pulse: root.press-pulse;
                        x: parent.width / 2 + dx - self.width / 2;
                        // Ancorado na base: itens sem imagem ficam só como texto pequeno embaixo;
                        // itens com imagem expandem suavemente para cima.
                        y: parent.height - self.height;
                    }
                }
            }

            // Linha discreta de contexto bem abaixo (sem pílulas pesadas ou efeitos)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: rgba(12, 14, 18, 0.48);
                    border-width: root.adjusting ? 1px : 0px;
                    border-color: rgba(96, 165, 250, 0.70);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: root.active-pill;
                            color: root.adjusting ? #93c5fd : rgba(240, 244, 248, 0.88);
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        if root.status-pill != "": Text {
                            text: "·  " + root.status-pill;
                            color: rgba(203, 213, 225, 0.72);
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
