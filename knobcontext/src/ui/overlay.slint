export component Overlay inherits Window {
    title: "KnobContext Overlay";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 480px;
    height: 172px;

    in property <string> active-profile-name: "Automático";
    in property <string> mode-subtitle: "Automático (global)";
    in property <[string]> profiles: ["Automático", "global", "firefox", "gimp"];
    in property <int> highlighted-index: 0;
    in property <int> active-index: 0;

    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(20, 20, 20, 0.85);
        border-radius: 12px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.1);

        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            alignment: center;

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.active-profile-name;
                    color: #f5f5f7;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.mode-subtitle;
                    color: #93c5fd;
                    font-size: 12px;
                    font-weight: 500;
                    horizontal-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                for name[idx] in root.profiles: Rectangle {
                    min-width: 84px;
                    height: 34px;
                    border-radius: 8px;
                    background: idx == root.highlighted-index
                        ? rgba(255, 255, 255, 0.18)
                        : rgba(255, 255, 255, 0.05);
                    border-width: 1px;
                    border-color: idx == root.highlighted-index
                        ? rgba(255, 255, 255, 0.45)
                        : (idx == root.active-index
                            ? rgba(255, 255, 255, 0.2)
                            : rgba(255, 255, 255, 0.06));

                    animate background, border-color {
                        duration: 150ms;
                        easing: ease-out;
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        Text {
                            text: name;
                            color: idx == root.highlighted-index ? #ffffff : #a1a1aa;
                            font-size: 13px;
                            font-weight: idx == root.highlighted-index ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-alignment: center;

                            animate color {
                                duration: 150ms;
                                easing: ease-out;
                            }
                        }
                    }
                }
            }

            Text {
                text: "Gire para alternar • Clique para selecionar";
                color: rgba(255, 255, 255, 0.52);
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}
