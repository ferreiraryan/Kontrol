import {
    Theme,
    AppButton,
    AppInput,
    StepperControl,
    AppListItem,
    MacroStepItem,
    PresetListItem,
    ProviderOptionItem,
    ProviderCommandItem,
} from "theme.slint";

component CategoryNavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <bool> selected: false;
    callback clicked();

    height: 31px;
    border-radius: 7px;
    background: root.selected
        ? Theme.accent-soft
        : (touch.has-hover ? rgba(255, 255, 255, 0.06) : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.border-accent : transparent;

    animate background { duration: 100ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 8px;

        Text {
            width: 18px;
            text: root.glyph;
            color: root.selected ? Theme.accent-text : Theme.text-muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MediaTile inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <bool> active: false;
    callback clicked();

    height: 62px;
    border-radius: 9px;
    background: root.active
        ? Theme.accent-soft
        : (touch.has-hover ? Theme.bg-elevated : Theme.bg-card);
    border-width: 1px;
    border-color: root.active
        ? Theme.border-focus
        : (touch.has-hover ? Theme.border-hover : Theme.border-subtle);

    animate background { duration: 110ms; easing: ease-out; }
    animate border-color { duration: 110ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding: 8px;

        Text {
            text: root.glyph;
            color: root.active ? Theme.accent-text : Theme.text-secondary;
            font-size: 18px;
            horizontal-alignment: center;
        }

        Text {
            text: root.title;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 12px;
            font-weight: root.active ? 600 : 500;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ActionEditorPopover inherits Rectangle {
    in property <string> control-title: "Key1";
    in property <string> profile-context-label: "";
    in property <string> inherited-hint: "";
    in property <int> selected-type-index: 0;
    in property <string> preview-text: "";

    // 0: Atalho de teclado
    in-out property <string> shortcut-text;
    in property <[string]> shortcut-parts: [];
    in property <string> active-preset-label: "";
    in property <bool> preset-dropdown-open: false;
    in property <[string]> preset-apps: [];
    in property <int> preset-app-index: 0;
    in property <[PresetListItem]> preset-items: [];

    // 1: Mídia
    in property <int> selected-media-index: 0;

    // 2: Abrir aplicativo
    in-out property <string> app-search;
    in property <[AppListItem]> filtered-apps;
    in property <int> selected-app-index: -1;
    in property <string> selected-app-label: "";

    // 3: URL / 4: Arquivo / 5: Comando
    in-out property <string> url-text;
    in-out property <string> file-text;
    in-out property <string> exec-text;

    // 6: Scroll
    in property <int> scroll-direction-index: 0;
    in property <int> scroll-amount: 1;

    // 7: Macro
    in property <[MacroStepItem]> macro-steps;
    in-out property <string> macro-key-text;
    in-out property <string> macro-wait-text: "100";

    // 9: Integração direta (Providers)
    in property <[ProviderOptionItem]> provider-options: [];
    in property <int> selected-provider-index: 0;
    in property <bool> selected-provider-available: false;
    in property <[ProviderCommandItem]> provider-commands: [];
    in property <int> selected-provider-command-index: 0;
    in property <string> provider-arg-label: "";
    in property <string> provider-arg-placeholder: "";
    in-out property <string> provider-arg-value: "";

    in property <string> error-message;

    callback select-type(int);
    callback open-learn-shortcut();
    callback shortcut-text-edited(string);
    callback toggle-shortcut-modifier(string);
    callback apply-shortcut-preset(string);
    callback toggle-preset-dropdown();
    callback select-preset-app(int);
    callback select-preset-item(int);
    callback clear-shortcut();
    callback select-media(int);
    callback app-search-changed(string);
    callback select-app(int);
    callback pick-file();
    callback select-scroll-direction(int);
    callback change-scroll-amount(int);
    callback set-scroll-amount(int);
    callback open-learn-macro();
    callback add-macro-key();
    callback add-macro-wait();
    callback add-macro-wait-preset(int);
    callback move-macro-step(int, int);
    callback remove-macro-step(int);
    callback select-provider(int);
    callback select-provider-command(int);
    callback provider-arg-edited(string);
    callback save-action();
    callback cancel-action();

    background: Theme.bg-scrim;

    // Bloqueia cliques no fundo atrás do modal
    TouchArea { }

    Rectangle {
        width: 720px;
        height: 500px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        background: Theme.bg-window;
        border-width: 1px;
        border-color: Theme.border-default;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Cabeçalho do modal
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Editar ação";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    if root.profile-context-label != "": Rectangle {
                        height: 22px;
                        border-radius: 6px;
                        background: Theme.bg-elevated;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.profile-context-label + " → " + root.control-title;
                                color: Theme.accent-text;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.profile-context-label == "": Rectangle {
                        height: 22px;
                        border-radius: 6px;
                        background: Theme.bg-elevated;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.control-title;
                                color: Theme.accent-text;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                AppButton {
                    width: 28px;
                    height: 28px;
                    ghost: true;
                    text: "×";
                    font-size: 16px;
                    clicked => { root.cancel-action(); }
                }
            }

            // Corpo principal: Sidebar de tipos + Painel de configuração
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                // Sidebar de categorias (agrupadas)
                Rectangle {
                    width: 204px;
                    border-radius: 10px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        Text {
                            text: "ENTRADA & ATALHOS";
                            color: Theme.text-dim;
                            font-size: 10px;
                            font-weight: 700;
                        }

                        CategoryNavItem {
                            glyph: "⌨";
                            title: "Atalho de teclado";
                            selected: root.selected-type-index == 0;
                            clicked => { root.select-type(0); }
                        }
                        CategoryNavItem {
                            glyph: "♫";
                            title: "Controle de mídia";
                            selected: root.selected-type-index == 1;
                            clicked => { root.select-type(1); }
                        }
                        CategoryNavItem {
                            glyph: "↕";
                            title: "Scroll";
                            selected: root.selected-type-index == 6;
                            clicked => { root.select-type(6); }
                        }
                        CategoryNavItem {
                            glyph: "⚡";
                            title: "Macro (sequência)";
                            selected: root.selected-type-index == 7;
                            clicked => { root.select-type(7); }
                        }

                        Rectangle { height: 6px; background: transparent; }

                        Text {
                            text: "SISTEMA & APPS";
                            color: Theme.text-dim;
                            font-size: 10px;
                            font-weight: 700;
                        }

                        CategoryNavItem {
                            glyph: "⊞";
                            title: "Abrir aplicativo";
                            selected: root.selected-type-index == 2;
                            clicked => { root.select-type(2); }
                        }
                        CategoryNavItem {
                            glyph: "↗";
                            title: "Abrir URL";
                            selected: root.selected-type-index == 3;
                            clicked => { root.select-type(3); }
                        }
                        CategoryNavItem {
                            glyph: "▤";
                            title: "Abrir arquivo";
                            selected: root.selected-type-index == 4;
                            clicked => { root.select-type(4); }
                        }
                        CategoryNavItem {
                            glyph: ">_";
                            title: "Executar comando";
                            selected: root.selected-type-index == 5;
                            clicked => { root.select-type(5); }
                        }
                        CategoryNavItem {
                            glyph: "◈";
                            title: "Integração direta";
                            selected: root.selected-type-index == 9;
                            clicked => { root.select-type(9); }
                        }

                        Rectangle { height: 4px; background: transparent; }

                        Text {
                            text: "OUTROS";
                            color: Theme.text-dim;
                            font-size: 10px;
                            font-weight: 700;
                        }

                        CategoryNavItem {
                            glyph: "∅";
                            title: "Nenhuma ação";
                            selected: root.selected-type-index == 8;
                            clicked => { root.select-type(8); }
                        }
                    }
                }

                // Painel específico do tipo escolhido
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 10px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    // 0: Atalho de teclado (Keycaps + Modo Aprender + Presets por App + Chips + Manual)
                    if root.selected-type-index == 0: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            Text {
                                text: "Atalho de teclado";
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            if root.active-preset-label != "": Rectangle {
                                height: 22px;
                                border-radius: 6px;
                                background: Theme.success-soft;
                                border-width: 1px;
                                border-color: rgba(34, 197, 94, 0.4);

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.active-preset-label;
                                        color: #86efac;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // Banner de Keycaps + Ação principal de captura + Dropdown Presets
                        Rectangle {
                            height: 86px;
                            border-radius: 10px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: root.shortcut-parts.length > 0
                                ? Theme.border-accent
                                : Theme.border-default;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    if root.shortcut-parts.length == 0: Text {
                                        text: "Nenhum atalho definido";
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }

                                    for part[pidx] in root.shortcut-parts: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        if pidx > 0: Text {
                                            text: "+";
                                            color: Theme.text-dim;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            height: 26px;
                                            border-radius: 6px;
                                            background: Theme.bg-elevated;
                                            border-width: 1px;
                                            border-color: Theme.border-accent;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                Text {
                                                    text: part;
                                                    color: Theme.text-primary;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    AppButton {
                                        height: 28px;
                                        primary: true;
                                        text: "⌨ Gravar tecla";
                                        clicked => { root.open-learn-shortcut(); }
                                    }

                                    AppButton {
                                        height: 28px;
                                        active: root.preset-dropdown-open;
                                        text: root.preset-dropdown-open ? "Presets ▴" : "Presets ▾";
                                        clicked => { root.toggle-preset-dropdown(); }
                                    }

                                    if root.shortcut-text != "": AppButton {
                                        height: 28px;
                                        text: "Limpar";
                                        clicked => { root.clear-shortcut(); }
                                    }
                                }
                            }
                        }

                        // Dropdown inline de Presets por aplicativo (Firefox / VSCode / Terminal)
                        if root.preset-dropdown-open: Rectangle {
                            vertical-stretch: 1;
                            border-radius: 9px;
                            background: Theme.bg-card;
                            border-width: 1px;
                            border-color: Theme.border-accent;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for app-name[aidx] in root.preset-apps: AppButton {
                                        height: 26px;
                                        font-size: 11px;
                                        active: aidx == root.preset-app-index;
                                        text: app-name;
                                        clicked => { root.select-preset-app(aidx); }
                                    }
                                }

                                Flickable {
                                    vertical-stretch: 1;
                                    content-height: root.preset-items.length * 34px;

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: start;

                                        for item[pidx] in root.preset-items: Rectangle {
                                            height: 30px;
                                            border-radius: 6px;
                                            background: pr-touch.has-hover ? Theme.accent-soft : Theme.bg-input;
                                            border-width: 1px;
                                            border-color: pr-touch.has-hover ? Theme.border-accent : Theme.border-subtle;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;

                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: item.name;
                                                    color: Theme.text-primary;
                                                    font-size: 12px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: item.combo;
                                                    color: Theme.accent-text;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            pr-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select-preset-item(pidx); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Chips rápidos de modificadores (visível quando dropdown de presets está fechado)
                        if !root.preset-dropdown-open: VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "Adicionar / remover modificador:";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 500;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                AppButton {
                                    height: 26px;
                                    text: "+ Ctrl";
                                    clicked => { root.toggle-shortcut-modifier("Ctrl"); }
                                }
                                AppButton {
                                    height: 26px;
                                    text: "+ Shift";
                                    clicked => { root.toggle-shortcut-modifier("Shift"); }
                                }
                                AppButton {
                                    height: 26px;
                                    text: "+ Alt";
                                    clicked => { root.toggle-shortcut-modifier("Alt"); }
                                }
                                AppButton {
                                    height: 26px;
                                    text: "+ Super";
                                    clicked => { root.toggle-shortcut-modifier("Super"); }
                                }
                            }
                        }

                        // Atalhos populares em 1 clique
                        if !root.preset-dropdown-open: VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "Atalhos comuns:";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 500;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                AppButton {
                                    height: 25px;
                                    font-size: 11px;
                                    text: "Ctrl+Tab";
                                    clicked => { root.apply-shortcut-preset("Ctrl+Tab"); }
                                }
                                AppButton {
                                    height: 25px;
                                    font-size: 11px;
                                    text: "Ctrl+Shift+Tab";
                                    clicked => { root.apply-shortcut-preset("Ctrl+Shift+Tab"); }
                                }
                                AppButton {
                                    height: 25px;
                                    font-size: 11px;
                                    text: "Ctrl+Z";
                                    clicked => { root.apply-shortcut-preset("Ctrl+Z"); }
                                }
                                AppButton {
                                    height: 25px;
                                    font-size: 11px;
                                    text: "Alt+F4";
                                    clicked => { root.apply-shortcut-preset("Alt+F4"); }
                                }
                                AppButton {
                                    height: 25px;
                                    font-size: 11px;
                                    text: "Super+E";
                                    clicked => { root.apply-shortcut-preset("Super+E"); }
                                }
                            }
                        }

                        // Edição manual (fallback)
                        if !root.preset-dropdown-open: VerticalLayout {
                            spacing: 5px;

                            Text {
                                text: "Edição manual (fallback para atalhos interceptados pelo Hyprland):";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }

                            AppInput {
                                placeholder: "ex: Ctrl+Shift+T, Super+E, Alt+F4";
                                text <=> root.shortcut-text;
                                edited(v) => { root.shortcut-text-edited(v); }
                            }
                        }

                        if !root.preset-dropdown-open: Rectangle { vertical-stretch: 1; }
                    }

                    // 1: Controle de mídia (Grid 2x3 em português)
                    if root.selected-type-index == 1: VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Controle de mídia";
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Comandos multimídia enviados diretamente ao sistema.";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            MediaTile {
                                horizontal-stretch: 1;
                                glyph: "🔊";
                                title: "Volume +";
                                active: root.selected-media-index == 0;
                                clicked => { root.select-media(0); }
                            }
                            MediaTile {
                                horizontal-stretch: 1;
                                glyph: "🔉";
                                title: "Volume −";
                                active: root.selected-media-index == 1;
                                clicked => { root.select-media(1); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            MediaTile {
                                horizontal-stretch: 1;
                                glyph: "🔇";
                                title: "Mudo";
                                active: root.selected-media-index == 2;
                                clicked => { root.select-media(2); }
                            }
                            MediaTile {
                                horizontal-stretch: 1;
                                glyph: "⏯";
                                title: "Play / Pause";
                                active: root.selected-media-index == 3;
                                clicked => { root.select-media(3); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            MediaTile {
                                horizontal-stretch: 1;
                                glyph: "⏮";
                                title: "Faixa anterior";
                                active: root.selected-media-index == 4;
                                clicked => { root.select-media(4); }
                            }
                            MediaTile {
                                horizontal-stretch: 1;
                                glyph: "⏭";
                                title: "Próxima faixa";
                                active: root.selected-media-index == 5;
                                clicked => { root.select-media(5); }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // 2: Abrir aplicativo (.desktop com busca e contagem)
                    if root.selected-type-index == 2: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            Text {
                                text: "Abrir aplicativo (.desktop)";
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.filtered-apps.length + " encontrados";
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        AppInput {
                            placeholder: "Filtrar por nome ou .desktop (ex: Firefox, GIMP, Spotify)...";
                            text <=> root.app-search;
                            edited(q) => { root.app-search-changed(q); }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-height: root.filtered-apps.length * 36px;

                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                if root.filtered-apps.length == 0: Text {
                                    text: "Nenhum aplicativo corresponde à busca.";
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                }

                                for app[idx] in root.filtered-apps: Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    background: idx == root.selected-app-index
                                        ? Theme.accent-soft
                                        : (a-touch.has-hover ? rgba(255, 255, 255, 0.07) : Theme.bg-card);
                                    border-width: 1px;
                                    border-color: idx == root.selected-app-index
                                        ? Theme.border-focus
                                        : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: app.name;
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            font-weight: idx == root.selected-app-index ? 600 : 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: app.desktop-file;
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    a-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select-app(idx); }
                                    }
                                }
                            }
                        }

                        if root.selected-app-label != "": Rectangle {
                            height: 28px;
                            border-radius: 7px;
                            background: Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.border-accent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: "Selecionado: " + root.selected-app-label;
                                    color: Theme.accent-text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // 3: Abrir URL
                    if root.selected-type-index == 3: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text {
                            text: "Abrir URL no navegador padrão";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        AppInput {
                            placeholder: "https://example.com";
                            text <=> root.url-text;
                        }

                        Text {
                            text: "Deve começar com http:// ou https://. Aberto via xdg-open.";
                            color: Theme.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // 4: Abrir arquivo
                    if root.selected-type-index == 4: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text {
                            text: "Abrir arquivo com o aplicativo padrão";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            AppInput {
                                horizontal-stretch: 1;
                                placeholder: "file:///caminho/do/arquivo";
                                text <=> root.file-text;
                            }

                            AppButton {
                                height: 32px;
                                primary: true;
                                text: "Escolher...";
                                clicked => { root.pick-file(); }
                            }
                        }

                        Text {
                            text: "Aceita caminhos locais ou URIs file:// (diálogo nativo XDG Portal).";
                            color: Theme.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // 5: Executar comando
                    if root.selected-type-index == 5: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text {
                            text: "Executar comando shell (avançado)";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        AppInput {
                            placeholder: "ex: playerctl play-pause";
                            text <=> root.exec-text;
                        }

                        Rectangle {
                            border-radius: 8px;
                            background: Theme.warning-soft;
                            border-width: 1px;
                            border-color: rgba(251, 191, 36, 0.35);

                            HorizontalLayout {
                                padding: 10px;
                                Text {
                                    text: "Executado em segundo plano via `sh -c` (suporta pipes e redirecionamentos). Use apenas comandos confiáveis.";
                                    color: #fde68a;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // 6: Scroll
                    if root.selected-type-index == 6: VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text {
                            text: "Rolagem (Scroll)";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Direção";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                AppButton {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    text: "↑ Cima";
                                    active: root.scroll-direction-index == 0;
                                    clicked => { root.select-scroll-direction(0); }
                                }
                                AppButton {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    text: "↓ Baixo";
                                    active: root.scroll-direction-index == 1;
                                    clicked => { root.select-scroll-direction(1); }
                                }
                                AppButton {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    text: "← Esquerda";
                                    active: root.scroll-direction-index == 2;
                                    clicked => { root.select-scroll-direction(2); }
                                }
                                AppButton {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    text: "→ Direita";
                                    active: root.scroll-direction-index == 3;
                                    clicked => { root.select-scroll-direction(3); }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Intensidade por passo (1 a 10)";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                StepperControl {
                                    value-text: root.scroll-amount + "×";
                                    decrement => { root.change-scroll-amount(-1); }
                                    increment => { root.change-scroll-amount(1); }
                                }

                                AppButton {
                                    height: 28px;
                                    active: root.scroll-amount == 1;
                                    text: "1×";
                                    clicked => { root.set-scroll-amount(1); }
                                }
                                AppButton {
                                    height: 28px;
                                    active: root.scroll-amount == 3;
                                    text: "3×";
                                    clicked => { root.set-scroll-amount(3); }
                                }
                                AppButton {
                                    height: 28px;
                                    active: root.scroll-amount == 5;
                                    text: "5×";
                                    clicked => { root.set-scroll-amount(5); }
                                }
                                AppButton {
                                    height: 28px;
                                    active: root.scroll-amount == 10;
                                    text: "10×";
                                    clicked => { root.set-scroll-amount(10); }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    // 7: Macro (timeline com reordenação + Modo Aprender + chips de espera)
                    if root.selected-type-index == 7: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Sequência de passos (Macro)";
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.macro-steps.length + " passos";
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-height: root.macro-steps.length * 36px;

                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                if root.macro-steps.length == 0: Rectangle {
                                    height: 60px;
                                    border-radius: 8px;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    Text {
                                        text: "Adicione teclas e pausas abaixo para montar a macro.";
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for step[idx] in root.macro-steps: Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 8px;

                                        Text {
                                            width: 18px;
                                            text: (idx + 1) + ".";
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            height: 20px;
                                            border-radius: 5px;
                                            background: step.is-wait ? Theme.warning-soft : Theme.accent-soft;
                                            border-width: 1px;
                                            border-color: step.is-wait
                                                ? rgba(251, 191, 36, 0.35)
                                                : Theme.border-accent;

                                            HorizontalLayout {
                                                padding-left: 7px;
                                                padding-right: 7px;
                                                Text {
                                                    text: step.is-wait ? "⏱ Espera" : "⌨ Tecla";
                                                    color: step.is-wait ? #fde68a : Theme.accent-text;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: step.label;
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        AppButton {
                                            width: 24px;
                                            height: 22px;
                                            ghost: true;
                                            text: "↑";
                                            clicked => { root.move-macro-step(idx, -1); }
                                        }
                                        AppButton {
                                            width: 24px;
                                            height: 22px;
                                            ghost: true;
                                            text: "↓";
                                            clicked => { root.move-macro-step(idx, 1); }
                                        }
                                        AppButton {
                                            width: 24px;
                                            height: 22px;
                                            danger: true;
                                            text: "×";
                                            clicked => { root.remove-macro-step(idx); }
                                        }
                                    }
                                }
                            }
                        }

                        // Adicionar passo de tecla
                        HorizontalLayout {
                            spacing: 6px;

                            AppButton {
                                height: 32px;
                                primary: true;
                                text: "⌨ Aprender";
                                clicked => { root.open-learn-macro(); }
                            }

                            AppInput {
                                horizontal-stretch: 1;
                                placeholder: "ou digite (ex: Ctrl+C)";
                                text <=> root.macro-key-text;
                            }

                            AppButton {
                                height: 32px;
                                text: "+ Tecla";
                                clicked => { root.add-macro-key(); }
                            }
                        }

                        // Adicionar passo de espera (chips rápidos + ms customizado)
                        HorizontalLayout {
                            spacing: 6px;

                            AppButton {
                                height: 28px;
                                font-size: 11px;
                                text: "+50ms";
                                clicked => { root.add-macro-wait-preset(50); }
                            }
                            AppButton {
                                height: 28px;
                                font-size: 11px;
                                text: "+100ms";
                                clicked => { root.add-macro-wait-preset(100); }
                            }
                            AppButton {
                                height: 28px;
                                font-size: 11px;
                                text: "+250ms";
                                clicked => { root.add-macro-wait-preset(250); }
                            }
                            AppInput {
                                horizontal-stretch: 1;
                                height: 28px;
                                placeholder: "ms";
                                text <=> root.macro-wait-text;
                            }
                            AppButton {
                                height: 28px;
                                font-size: 11px;
                                text: "+ Espera";
                                clicked => { root.add-macro-wait(); }
                            }
                        }
                    }

                    // 8: Nenhuma ação
                    if root.selected-type-index == 8: VerticalLayout {
                        padding: 24px;
                        alignment: center;
                        spacing: 10px;

                        Text {
                            text: "∅";
                            color: Theme.text-dim;
                            font-size: 32px;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Nenhuma ação própria neste controle";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.inherited-hint != ""
                                ? root.inherited-hint
                                : "Este controle ficará sem ação quando o perfil estiver ativo.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // 9: Integração direta (OBS, MPRIS, futuros providers)
                    if root.selected-type-index == 9: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            Text {
                                text: "Integração direta (API)";
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                height: 22px;
                                border-radius: 6px;
                                background: root.selected-provider-available
                                    ? Theme.success-soft
                                    : Theme.warning-soft;
                                border-width: 1px;
                                border-color: root.selected-provider-available
                                    ? rgba(34, 197, 94, 0.42)
                                    : rgba(251, 191, 36, 0.42);

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.selected-provider-available
                                            ? "● Disponível"
                                            : "○ Indisponível";
                                        color: root.selected-provider-available
                                            ? #86efac
                                            : #fde68a;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Seletor de Provider
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "Provider";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                for prov[pidx] in root.provider-options: Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    background: pidx == root.selected-provider-index
                                        ? Theme.accent-soft
                                        : (pv-touch.has-hover ? rgba(255, 255, 255, 0.08) : Theme.bg-card);
                                    border-width: 1px;
                                    border-color: pidx == root.selected-provider-index
                                        ? Theme.border-focus
                                        : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 12px;
                                        spacing: 7px;

                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            y: 12px;
                                            border-radius: 4px;
                                            background: prov.available ? Theme.success : Theme.text-dim;
                                        }

                                        Text {
                                            text: prov.name;
                                            color: pidx == root.selected-provider-index
                                                ? Theme.text-primary
                                                : Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: pidx == root.selected-provider-index ? 600 : 500;
                                            vertical-alignment: center;
                                        }
                                    }

                                    pv-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select-provider(pidx); }
                                    }
                                }
                            }
                        }

                        // Lista dinâmica de comandos do Provider selecionado
                        Text {
                            text: "Comando";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-height: root.provider-commands.length * 36px;

                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                for cmd[cidx] in root.provider-commands: Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    background: cidx == root.selected-provider-command-index
                                        ? Theme.accent-soft
                                        : (pc-touch.has-hover ? rgba(255, 255, 255, 0.07) : Theme.bg-card);
                                    border-width: 1px;
                                    border-color: cidx == root.selected-provider-command-index
                                        ? Theme.border-focus
                                        : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: cmd.name;
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            font-weight: cidx == root.selected-provider-command-index ? 600 : 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: cmd.id;
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    pc-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select-provider-command(cidx); }
                                    }
                                }
                            }
                        }

                        // Campo dinâmico de argumento (conforme ArgsSchema do comando)
                        if root.provider-arg-label != "": VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.provider-arg-label;
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 600;
                            }
                            AppInput {
                                placeholder: root.provider-arg-placeholder;
                                text <=> root.provider-arg-value;
                                edited(v) => { root.provider-arg-edited(v); }
                            }
                        }
                    }
                }
            }

            if root.error-message != "": Rectangle {
                border-radius: 7px;
                background: Theme.danger-soft;
                border-width: 1px;
                border-color: Theme.danger-border;

                HorizontalLayout {
                    padding: 8px;
                    Text {
                        text: root.error-message;
                        color: Theme.danger-text;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            // Rodapé com Preview ao vivo + Cancelar / Aplicar
            HorizontalLayout {
                spacing: 10px;
                alignment: space-between;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    border-radius: 7px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.preview-text;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    AppButton {
                        text: "Cancelar";
                        clicked => { root.cancel-action(); }
                    }

                    AppButton {
                        text: "Aplicar";
                        primary: true;
                        clicked => { root.save-action(); }
                    }
                }
            }
        }
    }
}
