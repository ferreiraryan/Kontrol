import { Theme, AppButton } from "theme.slint";

export component LearnWindow inherits Window {
    title: "KnobContext — Modo Aprender";
    width: 440px;
    height: 168px;
    always-on-top: true;
    background: Theme.bg-window;

    in property <string> target-label: "Key1";
    in property <string> combo-preview: "";
    in property <string> status-hint: "Pressione a combinação (Solte ou Enter para confirmar)";

    callback key-pressed(string, bool, bool, bool, bool, bool);
    callback key-released(string, bool, bool, bool, bool);
    callback cancel-requested();

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-window;
        border-width: 1px;
        border-color: Theme.border-accent;
        border-radius: 12px;

        capture-scope := FocusScope {
            width: 100%;
            height: 100%;

            init => {
                self.focus();
            }

            key-pressed(ev) => {
                root.key-pressed(
                    ev.text,
                    ev.modifiers.control,
                    ev.modifiers.alt,
                    ev.modifiers.shift,
                    ev.modifiers.meta,
                    ev.repeat,
                );
                return accept;
            }

            key-released(ev) => {
                root.key-released(
                    ev.text,
                    ev.modifiers.control,
                    ev.modifiers.alt,
                    ev.modifiers.shift,
                    ev.modifiers.meta,
                );
                return accept;
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: 4px;
                        border-radius: 4px;
                        background: Theme.accent;
                    }

                    Text {
                        text: "Modo Aprender • " + root.target-label;
                        color: Theme.accent-text;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                AppButton {
                    height: 22px;
                    font-size: 11px;
                    ghost: true;
                    text: "Cancelar (Esc)";
                    clicked => { root.cancel-requested(); }
                }
            }

            Rectangle {
                height: 54px;
                border-radius: 9px;
                background: root.combo-preview == ""
                    ? Theme.bg-input
                    : Theme.accent-soft;
                border-width: 1px;
                border-color: root.combo-preview == ""
                    ? Theme.border-default
                    : Theme.border-focus;

                animate background { duration: 120ms; easing: ease-out; }
                animate border-color { duration: 120ms; easing: ease-out; }

                Text {
                    text: root.combo-preview == "" ? "Aguardando teclas..." : root.combo-preview;
                    color: root.combo-preview == "" ? Theme.text-dim : Theme.text-primary;
                    font-size: root.combo-preview == "" ? 14px : 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.status-hint;
                color: Theme.text-muted;
                font-size: 11px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}
